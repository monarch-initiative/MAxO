AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0002328> "http://evolution.berkeley.edu/evolibrary/images/history/notochords.jpg")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0002328> "embryonic notocord")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0000135") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0002328> "notocord")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Notochord") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003011>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0002328> "notochorda")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0002328> "The notochord appears early in embryogeny and plays an important role in promoting or organizing the embryonic development of nearby structures. In most adult chordates the notochord disappears or becomes highly modified. In some non-vertebrate chordates and fishes the notochord persists as a laterally flexible but incompressible skeletal rod that prevents telescopic collapse of the body during swimming[TOLWEB]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0002328> "notochord")
