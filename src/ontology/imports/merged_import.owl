AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0048731> "system development")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048731> <http://purl.obolibrary.org/obo/GO_0048856>)
