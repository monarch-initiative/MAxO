AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MA:0001273") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0001173> "biliary tract")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0001173> "The path in many species is as follows: Bile canaliculi -> Canals of Hering (intralobar bile duct) -> interlobular bile ducts -> intrahepatic bile ducts -> left and right hepatic ducts merge to form -> common hepatic duct *exits liver* and joins -> cystic duct (from gall bladder) forming -> common bile duct -> joins with pancreatic duct -> forming ampulla of Vater -> enters duodenum [WP]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0001173> "biliary tree")
