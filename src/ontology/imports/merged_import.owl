AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0042571> "Note that an immunoglobulin complex has the function of antigen binding if a suitable antigen is available.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0042571> "immunoglobulin complex, circulating")
