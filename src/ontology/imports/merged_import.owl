AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0002461> "immune response-dependent tolerance induction")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0002461> "tolerance induction dependent upon immune response")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0002461> <http://purl.obolibrary.org/obo/GO_0002460>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0002461> <http://purl.obolibrary.org/obo/GO_0002507>)

