AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Lacrimal_groove") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.indiana.edu/~anat550/hnanim/face/face.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0006266> "Groove between maxillary prominence and lateral nasal process.")
