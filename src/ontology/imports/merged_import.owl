AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025338> "A plant structure development stage (PO:0009012) that has as primary participant a collective plant structure (PO:0025497).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/PO_0025338> "rwalls")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025338> "PO_GIT:391")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025338> "etapa de desarrollo de una estructura colectiva de la planta (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025338> "集合的植物構造の発生過程 (Japanese, exact)")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025338> "Includes flower development stage (PO:0007615), corolla development stage (PO:0007604), and inflorescence development stage (PO:0001083).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025338> "collective plant organ structure development stage")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025338> <http://purl.obolibrary.org/obo/PO_0009012>)
SubClassOf(<http://purl.obolibrary.org/obo/PO_0025338> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/PO_0025007>))

# Class: <http://purl.obolibrary.org/obo/PO_0025477> (floral organ primordium)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0025477> "A primordium (PO:0025127) that is committed to the development of a floral organ (PO:0025395) and is part of a reproductive shoot apex (PO:0025222).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/PO_0025477> "rwalls")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0025477> "PO_GIT:465")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "floral structure primordia (exact, plural)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "portion of floral structure primordium tissue (exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "primordio de organo floral (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025477> "花器官原基 (Japanese, exact)")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0025477> "If annotating to a primordium of a floral structure, it is better to use the more specific term, such as petal primordium (PO:0000021) or anther primordium (PO:0006089).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025477> "floral organ primordium")
