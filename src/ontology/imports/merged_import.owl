AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/PO_0025222> "rwalls")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025222> "&#225pice reproductivo del epiblasto (epiblastema) (Spanish, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0025222> "生殖シュート頂、茎頂 (Japanese, exact)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0025222> "reproductive shoot apex")
