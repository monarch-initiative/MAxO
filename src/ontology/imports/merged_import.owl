AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8720463") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pressbooks.pub/rbtallitsch/chapter/chapter-6-muscle-tissue/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_8600006> "A striated muscle tissue that is associated with soft internal organs (viscera).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/UBERON_8600006> <https://orcid.org/0000-0001-6677-8489>)
