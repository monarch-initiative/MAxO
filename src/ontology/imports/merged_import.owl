SubClassOf(<http://purl.obolibrary.org/obo/CL_0000652> <http://purl.obolibrary.org/obo/CL_0000710>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000652> <http://purl.obolibrary.org/obo/CL_0002319>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000652> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001905>))
