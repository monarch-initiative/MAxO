AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000351> "trophoblast cell")
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000351> <http://purl.obolibrary.org/obo/BFO_0000002>)
