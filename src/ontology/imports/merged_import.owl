AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411248> "brassica napus"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03411248> "rape plant"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411248> "canola"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411248> "canola plant"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411248> "Brassica napus L. emend. Metzg. var. napus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03411248> "oilseed rape plant"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411248> "rapeseed plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411248> <http://purl.obolibrary.org/obo/FOODON_03411017>)
