AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:DAN") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/pr#PRO-short-label>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000030035> "fam:GPCR")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000030035> "Category=family. Classification based on GRAFS system. [PMID:12761335]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000030035> "G-protein coupled receptor")
