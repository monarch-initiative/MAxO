AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400143> "fruit or fruit product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400143> <http://purl.obolibrary.org/obo/FOODON_03400257>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400148> (milk or milk product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400148> "Milk in all forms, milk-based beverage, cultured milk product, or milk or milk product analog. Index infant formula under *MEAL REPLACEMENT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400148> <http://www.langual.org/langual_thesaurus.asp?termid=A0148>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400148> "milk or milk product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400148> <http://purl.obolibrary.org/obo/FOODON_03400164>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400149> (milled grain or starch product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400149> "Food product prepared by milling a grain or by producing flour, meal or grits from a non-grain source such as beans, starchy roots or tubers. Refined starch is indexed under *REFINED OR PARTIALLY REFINED FOOD PRODUCT*."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400149> <http://www.langual.org/langual_thesaurus.asp?termid=A0149>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400149> "milled grain or starch product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400149> <http://purl.obolibrary.org/obo/FOODON_03400125>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400150> (meat or meat product (from mammal) (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400150> "Meat (flesh and organs including blood and bone marrow) from mammals. Used for meat in all forms including cured meat, sausage or luncheon meat and meat product analogs."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400150> <http://www.langual.org/langual_thesaurus.asp?termid=A0150>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400150> "meat or meat product (from mammal) (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400150> <http://purl.obolibrary.org/obo/FOODON_03400217>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400152> (vegetable or vegetable product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400152> "Vegetables in all forms except where a use-related product type descriptior (such as *PREPARED FOOD PRODUCT* or *SNACK FOOD*) takes precedence."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400152> <http://www.langual.org/langual_thesaurus.asp?termid=A0152>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400152> "vegetable or vegetable product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400152> <http://purl.obolibrary.org/obo/FOODON_03400257>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400164> (dairy product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400164> "Milk, a product derived from milk, or a dairy product analog; includes cheese and frozen dairy desserts. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400164> <http://www.langual.org/langual_thesaurus.asp?termid=A0164>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400164> "dairy product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400164> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400172> (prepared food product (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400172> "Food product that is 1) ready or nearly ready for consumption; 2) usually a composite of several foods or ingredients that often belong to distinct product types; 3) usually formulated, mixed and partially or fully cooked. Prepared foods often undergo several of the processes listed in *F. EXTENT OF HEAT TREATMENT* and *H. TREATMENT APPLIED*; these factors should be carefully considered in indexing. The classification of prepared food products emphasizes consumption characteristics. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400172> <http://www.langual.org/langual_thesaurus.asp?termid=A0172>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03400172> "prepared dish"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400172> "prepared food product (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400172> <http://purl.obolibrary.org/obo/FOODON_03401270>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400179> (condiment or relish (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400179> "Food product that is usually pungent, tart, salty, or spicy and is used to enhance the flavors of other foods; includes catsup, relish, prepared mustard, prepared horseradish, and condiment sauces."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400179> <http://www.langual.org/langual_thesaurus.asp?termid=A0179>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03400179> "relish or condiment"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03400179> "condiment or relish (us cfr)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03400179> <http://purl.obolibrary.org/obo/FOODON_03400105>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03400195> (malt beverage (us cfr))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03400195> "Alcoholic beverage prepared from water, malted grain and hops (humulus) by brewing. Examples are beer, ale and malt liquor (27 CFR 7.10)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03400195> <http://www.langual.org/langual_thesaurus.asp?termid=A0195>)
