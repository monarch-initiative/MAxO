AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0005622> "protoplast")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005622> "intracellular anatomical structure")
