AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003004>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0000440> "trabeculae")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000440> "trabecula")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0000440> <http://purl.obolibrary.org/obo/UBERON_0000064>)
