# Class: <http://purl.obolibrary.org/obo/FOODON_00002403> (food material)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002403> "Any substance that can be consumed by an organism to satisfy nutritional or other health needs, or to provide a social or organoleptic food experience"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002403> "food"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002403> "foodstuff"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002403> "nourishment"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_00002403> "sustenance"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00002403> "This class is the top of FOODON's main food product hierarchy which is described in the https://www.foodon.org website, and can be searched in lookup services like https://www.ebi.ac.uk/ols/"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002403> "food material"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002403> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002451> (food transformation process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002451> "A process involving the physical transformation of a food source or food product into some derived organic material or food product"@en)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_00002451> "https://orcid.org/0000-0002-8844-9165")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002451> "food transformation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002451> <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002451> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000299> <http://purl.obolibrary.org/obo/FOODON_00002403>))

# Class: <http://purl.obolibrary.org/obo/FOODON_00002452> (invertebrate animal)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002452> "Invertebrates are animals that neither possess nor develop a vertebral column (commonly known as a backbone or spine), derived from the notochord. This includes all animals apart from the subphylum Vertebrata."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002452> "invertebrate animal"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002452> <http://purl.obolibrary.org/obo/FOODON_00003004>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002454> (food material by characteristic)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002454> "Food material which has been categorized by a characteristic such as granularity or temperature."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00002454> "This term was renamed from \"food product by quality\" to align better with COB \"characteristic\" label, and as well to disambiguate from other use of \"quality\" as a food grading. This term is useful for tasks like food inspection where little prior knowledge of how the food came to be is available. Some terms like \"food (frozen)\" are both a quality descriptor and the output of a process."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002454> "food material by characteristic"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002454> <http://purl.obolibrary.org/obo/FOODON_00002403>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002470> (food material characteristic)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002470> "A physical object quality which describes a characteristic of some food material."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002470> "food material characteristic"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002470> <http://purl.obolibrary.org/obo/PATO_0001241>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002501> (multi-component food product)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002501> "A food product consisting of food material derived from ingredients sourced from multiple organisms."@en)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_00002501> "Damion Dooley")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002501> "2019-01-23T22:40:32Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_00002501> "multi-ingredient"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_00002501> "The definition of this is being discussed in issue: https://github.com/FoodOntology/foodon/issues/57

Namely, how to characterize the threshold of ingredients that make for multi-component classification? Salt, pepper, spices wouldn't normally make a food multi-component?"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002501> "multi-component food product"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002501> <http://purl.obolibrary.org/obo/FOODON_00001002>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002501> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002350> <http://purl.obolibrary.org/obo/FOODON_03400139>))

# Class: <http://purl.obolibrary.org/obo/FOODON_00002505> (dairy cattle)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002505> "Dairy cattle are a type of cattle bred for the ability to produce large quantities of milk, from which dairy products are made.  This class covers both male and female members of a dairy breed."@en)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002505> "2019-01-26T22:49:27Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002505> "dairy cattle"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002505> <http://purl.obolibrary.org/obo/FOODON_00002507>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002507> (taurine cattle)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002507> "Taurine cattle (Bos taurus taurus), also called European cattle, are a subspecies of domesticated cattle originating in the Near East. Both taurine cattle and indicine cattle (zebus) are descended from the aurochs. Taurine cattle were originally considered a distinct species, but are now typically grouped with zebus and aurochs into one species, Bos taurus. Most modern breeds of cattle are taurine cattle."@en)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002507> "2019-01-28T02:41:04Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_00002507> <http://www.langual.org/langual_thesaurus.asp?termid=B5186>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002507> "taurine cattle"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002507> <http://purl.obolibrary.org/obo/NCBITaxon_9913>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002581> (aquatic invertebrate)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002581> "An aquatic invertebrate may live entirely beneath the water, or may live upon its surface or on the plants surrounding it. Some breathe air, others breathe water. To move, they may walk, swim, float, skate, fly or glide on their bellies—or they may not move much at all."@en)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002581> "2019-04-29T19:23:38Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002581> "aquatic invertebrate"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002581> <http://purl.obolibrary.org/obo/FOODON_00002452>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002645> (food material by process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_00002645> "Food material organized by the process which it results from."@en)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_00002645> "2019-05-23T23:02:07Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_00002645> "food material by process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_00002645> <http://purl.obolibrary.org/obo/FOODON_00002403>)

# Class: <http://purl.obolibrary.org/obo/FOODON_00002664> (lipid food product)

