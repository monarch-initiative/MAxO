AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411156> "pod or seed vegetable plant"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03411156> <http://purl.obolibrary.org/obo/FOODON_03411057>)

