SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0002349>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0002539>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0002660>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0002690>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0002830>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0030210>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0015015> <http://purl.obolibrary.org/obo/PR_000002065>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0015015> <http://purl.obolibrary.org/obo/PR_000007431>))

