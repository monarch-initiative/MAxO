# Class: <http://purl.obolibrary.org/obo/FOODON_03420164> (animal material)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420164> "Material that derives from some animal."@en)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_03420164> "https://orcid.org/0000-0001-5275-8866")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_03420164> "2023-08-01T21:25:29Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420164> <http://www.langual.org/langual_thesaurus.asp?termid=C0164>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420164> "Langual note: Includes eggs and milk that, although separated from the animal, are produced as integral parts and are affected by the animal's food intake and metabolism."@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420164> "This branch isn't necessarily food material"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420164> "animal material"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420164> <http://purl.obolibrary.org/obo/FOODON_03420116>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420164> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001000> <http://purl.obolibrary.org/obo/FOODON_00003004>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03420167> (fruit part)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420167> "The fleshy fruit of any plant. *FRUIT* includes vegetables berries and pods as well. The bulk of a fruit is its fleshy part, which is covered by a peel (skin) and which encloses a core, pit or seeds."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420167> <http://www.langual.org/langual_thesaurus.asp?termid=C0167>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420167> "berry"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420167> "berry or fruit (anatomical part)"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420167> "fruit or berry, peel undetermined"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420167> "hip (fruit)"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420167> "infructescence"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420167> "LanguaL curation note: The descriptors under *FRUIT* are arrayed so that the indexer can check first whether the peel is present, removed or undetermined; then check the same informationfor the core, pit or seeds. For juices, beverages or jellies made from fruit, Index the entire part from which the product is derived.

Renamed from *FRUIT OR BERRY* in LanguaL 2008."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420167> "fruit part"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420167> <http://purl.obolibrary.org/obo/PO_0025496>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420167> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0009001>))

