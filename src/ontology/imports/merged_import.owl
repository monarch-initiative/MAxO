AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/GO_0097712> "pr")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0097712> "vesicle targeting, trans-Golgi to periciliary membrane compartment")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0097712> <http://purl.obolibrary.org/obo/GO_0048199>)
