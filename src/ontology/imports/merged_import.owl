AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0000962> "Innervates: sternohyoid muscle, sternothyroid muscle, omohyoid muscle[WP]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000962> "nerve of cervical vertebra")
