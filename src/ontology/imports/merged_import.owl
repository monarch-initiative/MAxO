# Class: <http://purl.obolibrary.org/obo/CL_0000077> (mesothelial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:tfm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0721662544") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26106328") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0000077> "A flat, squamous-like epithelial cell of mesodermal origin. It forms the mesothelium, which lines the body's serous cavities including the pleural, peritoneal, and pericardial spaces. This cell plays a crucial role in synthesizing and secreting lubricants, such as glycosaminoglycans and surfactants, which minimize friction between adjacent tissues during movement.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/CL_0000077> "FMA:66773")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0000077> "mesotheliocyte")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26106328") rdfs:comment <http://purl.obolibrary.org/obo/CL_0000077> "Mesothelial cells, which morphologically resemble squamous epithelial cells, express both epithelial markers (cytokeratins) and mesenchymal markers (vimentin), reflecting their mesodermal origin. They feature surface microvilli and apical-basal polarity. Under certain conditions, they can undergo mesothelial-to-mesenchymal transition. These cells also produce extracellular matrix proteins, maintain serosal homeostasis, and facilitate fluid transport.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000077> "mesothelial cell")
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000077> <http://purl.obolibrary.org/obo/CL_0000076>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000077> <http://purl.obolibrary.org/obo/CL_0002078>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0000077> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001136>))

