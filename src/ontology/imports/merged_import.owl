AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412112> <https://www.fao.org/fishery/en/aqspecies/mol>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03412112> "EC:No 216/2009 MOL")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03412112> "mollusk"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FOODON_03412112> "Mollusca")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412112> "mollusc"@en)
