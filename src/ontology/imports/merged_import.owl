# Class: <http://purl.obolibrary.org/obo/GO_0030202> (heparin proteoglycan metabolic process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22566225") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0030202> "The chemical reactions and pathways involving heparin proteoglycans, which consist of a core protein linked to a heparin glycosaminoglycan. The heparin chain is composed of the repeating disaccharide unit beta-(1,4)-N-acetyl-D-glucosamine-alpha-(1,4)-hexuronic acid, the former being either sulfated or deacetylated on its amino group as well as sulfated on one of its hydroxyl groups, and the latter being e a mixture of sulfated and nonsulfated D-glucuronic and L-iduronic acids. Heparin is similar to heparan sulfate but it contains more N-sulfate and O-sulfate groups. Heparin proteoglycans are stored selectively in the secretory granules of mammalian mast cells.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0030202> "heparin metabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0030202> "heparan sulfate metabolic process")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0030202> "heparin proteoglycan metabolic process")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0030202> <http://purl.obolibrary.org/obo/GO_0006029>)

# Class: <http://purl.obolibrary.org/obo/GO_0030210> (heparin proteoglycan biosynthetic process)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22566225") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0030210> "The chemical reactions and pathways resulting in the formation of heparin proteoglycans, which consist of a core protein linked to a heparin glycosaminoglycan. The heparin chain is composed of the repeating disaccharide unit beta-(1,4)-N-acetyl-D-glucosamine-alpha-(1,4)-hexuronic acid, the former being either sulfated or deacetylated on its amino group as well as sulfated on one of its hydroxyl groups, and the latter being a mixture of sulfated and nonsulfated D-glucuronic and L-iduronic acids. Heparin is similar to heparan sulfate but it contains more N-sulfate and O-sulfate groups. Heparin chains are covalently linked to serine/threonine residues (O-linked) of the core protein via a tetrasaccharide linker sequence (xylose-galactose-galactose-glucuronate).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0030210> "heparin anabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0030210> "heparin biosynthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0030210> "heparin formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0030210> "heparin synthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0030210> "heparan sulfate biosynthetic process")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0030210> "heparin proteoglycan biosynthetic process")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0030210> <http://purl.obolibrary.org/obo/GO_0030166>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0030210> <http://purl.obolibrary.org/obo/GO_0030202>)

