AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006267> "VHOG:0001212")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0006267> "notochordal plate")
