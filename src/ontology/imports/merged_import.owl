AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FOODON_03411367> "Vicia faba L. (varieties for human consumption)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03411367> "broad bean plant"@en)
