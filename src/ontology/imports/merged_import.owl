AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/PO_0009062> "gynoecium of lower floret of sessile spikelet of ear (narrow)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/PO_0009062> "gynoecium of lower floret of sessile spikelet of tassel (narrow)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/PO_0009062> "gynoecium of tassel floret (narrow)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/PO_0009062> "gynoecium of upper floret of pedicellate spikelet of ear (narrow)")
