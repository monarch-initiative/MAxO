AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10466080") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UniProtKB:Q07108") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000001343> "A protein that is a translation product of the human CD69 gene or a 1:1 ortholog thereof. A type II transmembrane protein with a C-type lectin binding domain in the extracellular portion of the molecule. Involved in lymphocyte proliferation and functions as a signal transmitting receptor in lymphocytes, natural killer (NK) cells, and platelets.")
