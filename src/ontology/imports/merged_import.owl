# Class: <http://purl.obolibrary.org/obo/FOODON_03420194> (egg or egg component)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420194> "Poultry, game bird or turtle eggs."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420194> <http://www.langual.org/langual_thesaurus.asp?termid=C0194>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420194> "LanguaL curation note: Fish roe are indexed under *OVARY, ROE*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420194> "egg or egg component"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420194> <http://purl.obolibrary.org/obo/FOODON_03420164>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420218> (organ meat)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420218> "Edible organ meat, including blood and bone marrow."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420218> <http://www.langual.org/langual_thesaurus.asp?termid=C0218>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420218> "variety meat"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420218> "organ meat"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420218> <http://purl.obolibrary.org/obo/FOODON_03420127>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420228> (extract, concentrate or isolate of plant or animal)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420228> "A physical-chemical component separated from the food source or its parts by extraction, centrifugation, filtration, heat processing, expressing or a similar process. The separated component may be converted through further processing. If this is done, the final substance is indexed. A water-extracted component may remain in aqueous dispersion. The extract, concentrate or isolate is indexed in preference to the anatomic part from which it is derived. For example, peanut oil is indexed under *PEANUT* combined wih *FAT OR OIL* rather than with *SEED OR KERNEL*. On the other hand, fruit and vegetable juices can be indexed under *FRUIT JUICE OR NECTAR* or *VEGETABLE JUICE* (A. PRODUCT TYPE); therefore the anatomic part of the plant should be indexed."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420228> "langual:C0228")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420228> "Damion Dooley's note: Items in this branch will be merged into foodon food product branch."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420228> "extract, concentrate or isolate of plant or animal"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420228> <http://purl.obolibrary.org/obo/FOODON_00001714>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420229> (fruit, peel removed, core, pit or seed removed)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420229> <http://www.langual.org/langual_thesaurus.asp?termid=C0229>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03420229> "flesh of fruit"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420229> "LanguaL curation note: Renamed from *FRUIT OR BERRY, PEEL REMOVED, CORE, PIT OR SEED REMOVED* in LanguaL 2008."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420229> "fruit, peel removed, core, pit or seed removed"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420229> <http://purl.obolibrary.org/obo/FOODON_03420138>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420236> (protein extract, concentrate or isolate)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420236> "Extract, concentrate or isolate high in protein; may contain amino acids, polypeptides and enzymes."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420236> <http://www.langual.org/langual_thesaurus.asp?termid=C0236>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420236> <http://www.langual.org/langual_thesaurus.asp?termid=H0164>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420236> "protein extract, concentrate or isolate"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420236> <http://purl.obolibrary.org/obo/FOODON_03420228>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420271> (sugar syrup or syrup solids)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420271> <http://www.langual.org/langual_thesaurus.asp?termid=C0271>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420271> <http://www.langual.org/langual_thesaurus.asp?termid=H0280>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03420271> "LanguaL curation note: Used when a sugar syrup or sugar syrup solids is the major ingredient. Sugar syrup is a liquid or semiliquid high in sugar content derived from a plant source through extraction possibly followed by conversion and/or concentration. A sugar syrup usually contains several sugars in varying proportions. Sugar syrup solids are derived by removing water from sugar syrup."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420271> "sugar syrup or syrup solids"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420271> <http://purl.obolibrary.org/obo/FOODON_03420108>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420272> (high fructose syrup)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420272> <http://www.langual.org/langual_thesaurus.asp?termid=C0272>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420272> "langual:C0272")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420272> "high fructose syrup"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420272> <http://purl.obolibrary.org/obo/FOODON_03301305>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420307> (seed oil)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420307> "The oil produced by pressing or extracting lipids from plant seeds (e.g. grapeseed oil, rapeseed oil, linseed oil) /AM"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03420307> <http://www.langual.org/langual_thesaurus.asp?termid=C0307>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420307> "seed oil"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420307> <http://purl.obolibrary.org/obo/FOODON_00001087>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430113> (food physical quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430113> "The physical state of the food product (liquid, semiliquid, semisolid, or solid). Solid food products are further subdivided by shape or form. Terms are provided for products that have both liquid and solid components or that incorporate air or other gases. [FDA CFSAN 1995]"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430113> <http://www.langual.org/langual_thesaurus.asp?termid=E0113>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430113> "Damion Dooley's note: these categories need to be mapped over to PATO phenotypic categories, with a suitable treatment of mixtures of solids that are divided into parts."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430113> "food physical quality"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430113> <http://purl.obolibrary.org/obo/FOODON_00002470>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430130> (food (liquid))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430130> "A state of matter between a solid and a gas, in which a substance has the capacity to flow and conforms to the shape of the container."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FOODON_03430130> "fluid"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430130> <http://www.langual.org/langual_thesaurus.asp?termid=E0130>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430130> <https://bioregistry.io/reference/siren:F5105>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430130> "Liquids range from water to honey, corresponding to a range in viscosity (or apparent viscosity) from 1 to 500 centipoise (viscosity is a measure of a liquid's resistance to flow). Products that are pourable but have a higher viscosity are *SEMILIQUID*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430130> "food (liquid)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430130> <http://purl.obolibrary.org/obo/FOODON_00002454>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430130> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0001548>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03430131> (whole)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03430131> "Refers to natural or formed shape as appropriate, regardless of size, which may vary from very large (e.g., beef carcass) to very small (e.g., poppy seed, yeast cell)."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430131> <http://www.langual.org/langual_thesaurus.asp?termid=E0131>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430131> "whole"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430131> <http://purl.obolibrary.org/obo/FOODON_03430113>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03430150> (whole, natural shape)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03430150> <http://www.langual.org/langual_thesaurus.asp?termid=E0150>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03430150> "LanguaL curation note: Whole refers not only to a whole plant or animal but also to a whole part as indexed in C. PART OF PLANT OR ANIMAL; examples of whole natural products are: an apple, rice in grain form, an asparagus spear, a spinach leaf, a beef carcass, a dressed chicken, a chicken drumstick, a calf liver. Products may have been slightly modified during processing and preservation (e.g., raisins or a pear that has been peeled and cored)."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03430150> "whole, natural shape"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03430150> <http://purl.obolibrary.org/obo/FOODON_03430131>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460111> (food treatment process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460111> "Used to specifically characterize a food product based on the treatment or processes applied to the product or any indexed ingredient. The processes include adding, substituting or removing components or modifying the food or component, e.g., through fermentation."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460111> "http://www.langual.org/langual_thesaurus.asp?termid=H0111")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460111> "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460111> "food treatment process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460111> <http://purl.obolibrary.org/obo/FOODON_00002451>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460119> (microbial/enzymatic modification process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460119> "A food modification process by microbial or enzymatic action which results in molecular changes in any food component."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460119> "http://www.langual.org/langual_thesaurus.asp?termid=H0119")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03460119> "fermented, unspecified"@en)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460119> "LanguaL curation note: If salt, sugar or other food additive is used to aid in the modification process, index it by the appropriate term under *INGREDIENT ADDED*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460119> "microbial/enzymatic modification process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460119> <http://purl.obolibrary.org/obo/FOODON_03460141>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460141> (food modification process)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460141> "http://www.langual.org/langual_thesaurus.asp?termid=H0141")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460141> "LanguaL curation note: Used when the food product underwent mechanical, chemical or enzymatic modification that has affected the texture, flavor or other characteristic of the product."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460141> "food modification process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460141> <http://purl.obolibrary.org/obo/FOODON_03460111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460177> (plant seed or nut food product)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460177> "langual:H0177")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460177> "LanguaL curation note: With the exception of peanut (see *PEANUT OR PEANUT BUTTER ADDED*), used when a nut or seed ingredient is the second ingredient in order of predominance."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460177> "plant seed or nut food product"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460177> <http://purl.obolibrary.org/obo/FOODON_00001015>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460230> (single component food fermentation)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460230> "http://www.langual.org/langual_thesaurus.asp?termid=H0230")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460230> "LanguaL curation note: Used for products in which either carbohydrates, proteins or fats were modified through microbial processes. Enzymatic or other biological processes may also be involved. If two or more of these components are modified in significant amounts, index under *FERMENTED/MODIFIED, MULTIPLE COMPONENT*."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460230> "single component food fermentation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460230> <http://purl.obolibrary.org/obo/FOODON_00001304>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460232> (alcohol fermentation)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460232> "http://www.langual.org/langual_thesaurus.asp?termid=H0232")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460232> "alcohol fermentation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460232> <http://purl.obolibrary.org/obo/FOODON_03460256>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03460256> (carbohydrate fermentation)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460256> "http://www.langual.org/langual_thesaurus.asp?termid=H0256")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasSynonym> <http://purl.obolibrary.org/obo/FOODON_03460256> "yeast leavened"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460256> "carbohydrate fermentation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460256> <http://purl.obolibrary.org/obo/FOODON_03460230>)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460256> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000293> <http://purl.obolibrary.org/obo/FOODON_03411345>))

# Class: <http://purl.obolibrary.org/obo/FOODON_03460263> (vegetable fat or oil)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03460263> "A fat or oil derived from vegetable material"@en)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_03460263> "Damion Dooley"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03460263> "langual:H0263")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03460263> "This is a convenience class inherited from LanguaL"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03460263> "vegetable fat or oil"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03460263> <http://purl.obolibrary.org/obo/FOODON_00001174>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03470107> (food preservation process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03470107> "The methods contributing to the prevention or retardation of microbial, enzymatic or oxidative spoilage and thus to the extension of shelf life. Index all methods for which information is available, even if a corresponding descriptor has already been used in *H. TREATMENT APPLIED*. Preservation descriptors refer to the finished food as a whole with these exceptions: (1) if the components of a multi-component food, such as cream pie, are preservation by different methods, index all methods; (2)  if chemical preservatives are declared on the label, always index them even if it is known that the preservative was introduced through or is only present in a component or ingredient of the food; and (3) if the preservation method for an ingredient is declared on the label (such as brie cheese made from pasteurized milk) index it. Also use *INGREDIENT preservation by THERMAL PROCESSING* or *INGREDIENT preservation by IRRADIATION* when ingredients have been pasteurized, ultrapasteurized, sterilized or irradiated."@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03470107> "http://www.langual.org/langual_thesaurus.asp?termid=J0107")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03470107> "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03470107> "food preservation process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03470107> <http://purl.obolibrary.org/obo/FOODON_03460111>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03530146> (butchery cut of animal)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03530146> "A piece of animal meat which has been cut according to butchery practice."@en)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FOODON_03530146> "https://orcid.org/0000-0001-5275-8866")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FOODON_03530146> "2023-08-01T21:25:29Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FOODON_03530146> <http://www.langual.org/langual_thesaurus.asp?termid=Z0146>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FOODON_03530146> "A cut of meat may have an arbitrary boundary that does not conform to an anatomical part. For example, a steak can be taken from a variety of locations."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03530146> "butchery cut of animal"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03530146> <http://purl.obolibrary.org/obo/FOODON_00004332>)

# Class: <http://purl.obolibrary.org/obo/GO_0000226> (microtubule cytoskeleton organization)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000226> "A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of cytoskeletal structures comprising microtubules and their associated proteins.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0000226> "microtubule cytoskeleton organisation")
