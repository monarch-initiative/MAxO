        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001987 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002014"/>
        <obo:IAO_0000115>A structural quality inhering in a bearer by virtue of the bearer&apos;s having a three dimensional cavity with a narrow or no opening, and often containing an anatomical substance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>sacular</oboInOwl:hasExactSynonym>
        <rdfs:label>saccular</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001987"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A structural quality inhering in a bearer by virtue of the bearer&apos;s having a three dimensional cavity with a narrow or no opening, and often containing an anatomical substance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:MAH</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001995"/>
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s consisting cells.</obo:IAO_0000115>
        <rdfs:label>cellularity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An organismal quality inhering in a bearer by virtue of the bearer&apos;s consisting cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001993 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001992"/>
        <obo:IAO_0000115>A cellularity quality inhering in a bearer by virtue of the bearer&apos;s consisting of more than one cell.</obo:IAO_0000115>
        <rdfs:label>multicellular</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001993"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cellularity quality inhering in a bearer by virtue of the bearer&apos;s consisting of more than one cell.</owl:annotatedTarget>
