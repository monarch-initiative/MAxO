        <oboInOwl:hasDbXref>GOC:tb</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0060295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003352"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_1902019"/>
