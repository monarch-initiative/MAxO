    <!-- http://purl.obolibrary.org/obo/GO_0046541 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0046541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007589"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0022600"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0032941"/>
        <obo:IAO_0000115>The regulated release of saliva from the salivary glands. In man, the saliva is a turbid and slightly viscous fluid, generally of an alkaline reaction, and is secreted by the parotid, submaxillary, and sublingual glands. In the mouth the saliva is mixed with the secretion from the buccal glands. In man and many animals, saliva is an important digestive fluid on account of the presence of the peculiar enzyme, ptyalin.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Salivation</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>salivation</oboInOwl:hasExactSynonym>
        <rdfs:label>saliva secretion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0046541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The regulated release of saliva from the salivary glands. In man, the saliva is a turbid and slightly viscous fluid, generally of an alkaline reaction, and is secreted by the parotid, submaxillary, and sublingual glands. In the mouth the saliva is mixed with the secretion from the buccal glands. In man and many animals, saliva is an important digestive fluid on account of the presence of the peculiar enzyme, ptyalin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UBERON:0001836</oboInOwl:hasDbXref>
    </owl:Axiom>
    


