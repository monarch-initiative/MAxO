    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0048754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0035239"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0061138"/>
