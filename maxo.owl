        <oboInOwl:hasExactSynonym>ligand-dependent GPCR activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>receptor activity, G-protein coupled</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>EBV-induced receptor</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Epstein-Barr Virus-induced receptor activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>G-protein coupled receptor activity, unknown ligand</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Mas proto-oncogene receptor activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>RDC1 receptor activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>SREB receptor</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>orphan G protein coupled receptor activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>orphan G-protein coupled receptor activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>orphan GPCR activity</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>super conserved receptor expressed in brain receptor activity</oboInOwl:hasNarrowSynonym>
        <rdfs:label>G protein-coupled receptor activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0004930"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Combining with an extracellular signal and transmitting the signal across the membrane by activating an associated G-protein; promotes the exchange of GDP for GTP on the alpha subunit of a heterotrimeric G-protein complex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:bf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:GPCR</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0004930"/>
