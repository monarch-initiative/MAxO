        <rdfs:label xml:lang="en">stereotactic radiosurgery</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0009088"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A procedure that delivers a single, highly concentrated dose of ionizing radiation from an external source to a small, precise target using 3-D computerized imaging to focus beams. There is no incision, but this technique distorts and destroys the DNA of tumor cells in a highly directed fashion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://www.aans.org/en/Patients/Neurosurgical-Conditions-and-Treatments/Stereotactic-Radiosurgery"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0009088"/>
