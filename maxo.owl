    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000942 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000939"/>
        <obo:IAO_0000115>A procedure that uses a device to stimulate the vagus nerve with electrical impulses.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-12T19:05:29Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <rdfs:label xml:lang="en">vagus nerve stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000939"/>
        <obo:IAO_0000115>A neurosurgical procedure involving the placement of a medical device called a neurostimulator (sometimes referred to as a &quot;brain pacemaker&quot;), which sends electrical impulses, through implanted electrodes, to specific targets in the brain (brain nuclei) for the treatment of movement disorders, including Parkinson&apos;s disease, essential tremor, and dystonia.[1] and other conditions such as obsessive-compulsive disorder and epilepsy.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-12T19:24:31Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>DBS</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">deep brain stimulation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000943"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neurosurgical procedure involving the placement of a medical device called a neurostimulator (sometimes referred to as a &quot;brain pacemaker&quot;), which sends electrical impulses, through implanted electrodes, to specific targets in the brain (brain nuclei) for the treatment of movement disorders, including Parkinson&apos;s disease, essential tremor, and dystonia.[1] and other conditions such as obsessive-compulsive disorder and epilepsy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://en.wikipedia.org/wiki/Deep_brain_stimulation"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>DBS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000944 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000939"/>
        <obo:IAO_0000115>The use of skin electrodes to pass a low intensity, pulsed electrical current through the scalp and into the brain. This procedure is used to treat a variety of illnesses including anxiety, depression, and chronic pain.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-12T19:29:07Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasDbXref>NCIT:C116561</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cranial electrical stimulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000939"/>
        <obo:IAO_0000115>An invasive procedure to stimulate the spinal cord to aid in the management of chronic, intractable pain of the trunk and/or limbs, including unilateral or bilateral pain.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-12T19:30:24Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <rdfs:label xml:lang="en">spinal cord stimulation</rdfs:label>
    </owl:Class>
    


