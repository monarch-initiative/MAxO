    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001563 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/FOODON_00001563">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002420"/>
        <obo:IAO_0000115 xml:lang="en">A defining ingredient defines what a food is principally categorized as, rather than an ingredient listed by percentage of weight or volume. A food may have more than one defining ingredient.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has defining ingredient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002420 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/FOODON_00002420">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0009001"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002403"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001002"/>
        <obo:IAO_0000115 xml:lang="en">A relation attaching between a food material and another food material that has been added to it at some point in its history.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has ingredient</rdfs:label>
    </owl:ObjectProperty>
    


