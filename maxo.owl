    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000002"/>
        <obo:IAO_0000115>The insertion of a cannula or tube into a hollow body organ.</obo:IAO_0000115>
