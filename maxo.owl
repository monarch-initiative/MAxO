    <!-- http://purl.obolibrary.org/obo/UBERON_0005176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004121"/>
