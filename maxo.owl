        <oboInOwl:hasExactSynonym>MALT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithelio-lymphoid tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosa associated lymphatic tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosa associated lymphoid tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosa-associated lymphoid tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosal-associated lymphatic tissue</oboInOwl:hasExactSynonym>
