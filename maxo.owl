    <!-- http://purl.obolibrary.org/obo/CHEBI_176783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_176783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
