     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ncbitaxon="http://purl.obolibrary.org/obo/ncbitaxon#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/maxo.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/maxo/releases/2025-04-24/maxo.owl"/>
        <obo:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <dce:creator>Leigh Carmody</dce:creator>
        <dce:creator>Peter Robinson</dce:creator>
        <dce:description>An ontology to represent medically relevant actions, procedures, therapies, interventions, and recommendations.</dce:description>
        <dce:title>Medical Action Ontology</dce:title>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <owl:versionInfo>2025-04-24</owl:versionInfo>
    </owl:Ontology>
    


