        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>nephric cord</owl:annotatedTarget>
        <oboInOwl:hasDbXref>VHOG:0001240</oboInOwl:hasDbXref>
    </owl:Axiom>
    


