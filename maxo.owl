                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000873"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A specimen collection that obtains a sample of tissue or cell from a living multicellular organism body for diagnostic purposes by means intended to be minimally invasive.</obo:IAO_0000115>
        <rdfs:label>biopsy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002651 -->

