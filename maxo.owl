                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Therapy that inhibits HMG-CoA reductase inhibitor.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-17T21:37:04Z</dce:date>
