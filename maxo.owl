    <!-- http://purl.obolibrary.org/obo/GO_0006903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009987"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0016192"/>
