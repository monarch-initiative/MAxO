        <oboInOwl:hasDbXref>GOC:cls</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dph</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:jid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO_REF:0000021</oboInOwl:hasDbXref>
    </owl:Axiom>
    


