        <owl:annotatedTarget>os planum</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Flat_bone</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000485"/>
        <obo:IAO_0000115>A simple columnar epithelium that looks stratified but is not, because its cells are arranged with their nuclei at different levels.</obo:IAO_0000115>
