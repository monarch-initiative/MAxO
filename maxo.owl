                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400113"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A food product that has some spice or herb as a defining ingredient.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="en">A vegetable product such as leaves, flowers, seeds and roots that is rich in essential oils and aromatic principles. Used mainly a a condiment.</obo:IAO_0000115>
        <dcterms:contributor>https://orcid.org/0000-0001-5275-8866</dcterms:contributor>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-16T10:14:35Z</dcterms:date>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=H0151"/>
        <oboInOwl:hasExactSynonym xml:lang="en">herb or spice</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">spice or herb</rdfs:label>
    </owl:Class>
    


