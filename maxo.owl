        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An endoscopic technique that allows deep intubation of the small intestine while using a standard endoscope. An inflatable balloon attached to the endoscope&apos;s tip acts as a stabilizer and a second balloon that is advanced ahead of the endoscope acts as a pulling device.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C64865</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000134 -->

