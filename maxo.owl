    <!-- http://purl.obolibrary.org/obo/FOODON_03316061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03316061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001275"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_02010002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An egg which is produced by an oviperous chicken.</obo:IAO_0000115>
        <dcterms:contributor>https://orcid.org/0000-0001-5275-8866</dcterms:contributor>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-27T22:43:12Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">egg</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F16061"/>
        <oboInOwl:hasExactSynonym xml:lang="en">chicken egg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hen egg</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">This term is ambiguous about whether shell remains on egg or not, i.e. this encompasses both an uncooked egg in shell, or a boiled peeled egg, or a fried egg.

SIREN DB annotation:
* whole egg FOODON:03420274</rdfs:comment>
        <rdfs:label xml:lang="en">chicken egg</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03317170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03317170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001006"/>
        <obo:IAO_0000115 xml:lang="en">A meat product is a product organized by the form of - or processing done to - its meat component (a skeletal meat part of an animal or crustacean).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F17170"/>
        <rdfs:comment xml:lang="en">SIREN DB annotation:
* animal body or body part FOODON:03420127</rdfs:comment>
        <rdfs:label xml:lang="en">meat (whole or pieces)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400143"/>
        <obo:IAO_0000115 xml:lang="en">Liquid food prepared from fruit (21 CFR 146). Products prepared from fruit juice by thickening with pectin are indexed under *FRUIT JELLY*; those thickened with gelatin are under *FRUIT BUTTER, JELLY, PRESERVE OR RELATED PRODUCT*.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0104"/>
        <rdfs:label xml:lang="en">fruit juice or related product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Seasoned product that contains multiple ingredients and that is used in limited amounts to accompany other foods; excludes flavors, spices and herbs.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0105"/>
        <oboInOwl:hasSynonym xml:lang="en">condiment, dressing, gravy or sauce</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">gravy, condiment, dressing or sauce</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">sauce, condiment, dressing or gravy</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">dressing, condiment, gravy or sauce (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400133"/>
        <obo:IAO_0000115 xml:lang="en">Aromatic or pungent plant product used whole or ground as a seasoning in food products.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0113"/>
        <oboInOwl:hasSynonym xml:lang="en">herb or spice</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">spice or herb (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400237"/>
        <obo:IAO_0000115 xml:lang="en">A substance having greater than 2% of the caloric value of sucrose per equivalent unit of sweetening capacity. For example, the amount of such subtance having the sweetening capacity of 1 teaspoon of sucrose would have more than 0.4 calories (21 CFR 170.3(o)(21)).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0118"/>
        <oboInOwl:hasSynonym xml:lang="en">nutritive carbohydrate sweetener</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">sweetener, nutritive</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">nutritive sweetener (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Any form of whole or milled grain, prepared grain product or starch containing product derived from non-grain sources. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0125"/>
        <rdfs:label xml:lang="en">grain or starch product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400104"/>
        <obo:IAO_0000115 xml:lang="en">The liquid extracted or expressed from mature fruit with or without the application of heat. Includes concentrated juice and single-strength juice. If the single-strength juice is prepared from concentrate, then *WATER ADDED* should be used. Carbonated fruit juices are indexed by *FRUIT JUICE* or *FRUIT JUICE, DILUTED* and *CARBONATED* or the appropriate narrower term.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0127"/>
        <oboInOwl:hasSynonym xml:lang="en">juice, fruit</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">fruit juice (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Extract, concentrate or isolate derived from a food source through one or more refining steps (see *EXTRACT, CONCENTRATE OR ISOLATE OF PLANT OR ANIMAL*) and marketed as such. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0129"/>
        <rdfs:label xml:lang="en">refined or partially-refined food product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Product that imparts or helps to impart a taste or aroma in food (21 CFR.170.3(n)(26). [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0133"/>
        <oboInOwl:hasSynonym xml:lang="en">seasoning or flavoring</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">flavoring or seasoning (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400172"/>
        <obo:IAO_0000115 xml:lang="en">A multiple-component food product typically containing a protein source, a vegetable, and a potato, rice or cereal-based component packaged to be served after heating, either as separate items or courses or mixed as recipe components; see 21 CFR 102.26, 102.28 and 104.47 for nutritional quality guidelines.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0139"/>
        <oboInOwl:hasSynonym xml:lang="en">compartmentalized dinner</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">dinner with components separated in serving containers</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">dinner, compartmentalized</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">food packs with separate components</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">heat and serve dinner</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">multiple-course dinner</oboInOwl:hasSynonym>
        <oboInOwl:hasSynonym xml:lang="en">tv dinner</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">multicomponent meal (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400257"/>
        <obo:IAO_0000115 xml:lang="en">Fruit in all forms; includes fruit juices and fruit juice drinks, fruit butters, jellies, preserves, and related products.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0143"/>
        <oboInOwl:hasSynonym xml:lang="en">pie filling, fruit</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">fruit or fruit product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400164"/>
        <obo:IAO_0000115 xml:lang="en">Milk in all forms, milk-based beverage, cultured milk product, or milk or milk product analog. Index infant formula under *MEAL REPLACEMENT*.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0148"/>
        <rdfs:label xml:lang="en">milk or milk product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400125"/>
        <obo:IAO_0000115 xml:lang="en">Food product prepared by milling a grain or by producing flour, meal or grits from a non-grain source such as beans, starchy roots or tubers. Refined starch is indexed under *REFINED OR PARTIALLY REFINED FOOD PRODUCT*.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0149"/>
        <rdfs:label xml:lang="en">milled grain or starch product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400217"/>
        <obo:IAO_0000115 xml:lang="en">Meat (flesh and organs including blood and bone marrow) from mammals. Used for meat in all forms including cured meat, sausage or luncheon meat and meat product analogs.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0150"/>
        <rdfs:label xml:lang="en">meat or meat product (from mammal) (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400257"/>
        <obo:IAO_0000115 xml:lang="en">Vegetables in all forms except where a use-related product type descriptior (such as *PREPARED FOOD PRODUCT* or *SNACK FOOD*) takes precedence.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0152"/>
        <rdfs:label xml:lang="en">vegetable or vegetable product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Milk, a product derived from milk, or a dairy product analog; includes cheese and frozen dairy desserts. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0164"/>
        <rdfs:label xml:lang="en">dairy product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Food product that is 1) ready or nearly ready for consumption; 2) usually a composite of several foods or ingredients that often belong to distinct product types; 3) usually formulated, mixed and partially or fully cooked. Prepared foods often undergo several of the processes listed in *F. EXTENT OF HEAT TREATMENT* and *H. TREATMENT APPLIED*; these factors should be carefully considered in indexing. The classification of prepared food products emphasizes consumption characteristics. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0172"/>
        <oboInOwl:hasSynonym xml:lang="en">prepared dish</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">prepared food product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400105"/>
        <obo:IAO_0000115 xml:lang="en">Food product that is usually pungent, tart, salty, or spicy and is used to enhance the flavors of other foods; includes catsup, relish, prepared mustard, prepared horseradish, and condiment sauces.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0179"/>
        <oboInOwl:hasSynonym xml:lang="en">relish or condiment</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">condiment or relish (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400278"/>
        <obo:IAO_0000115 xml:lang="en">Alcoholic beverage prepared from water, malted grain and hops (humulus) by brewing. Examples are beer, ale and malt liquor (27 CFR 7.10).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0195"/>
        <rdfs:label xml:lang="en">malt beverage (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Products of the flesh of animals. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0217"/>
        <rdfs:label xml:lang="en">meat, poultry, seafood or related product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FOODON_03301977"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FOODON_03301977"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Alcoholic or nonalcoholic beverage; excludes milk and milk-based beverages, fruit juices and fruit juice drinks, and vegetable juices. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0229"/>
        <rdfs:label xml:lang="en">beverage (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400133"/>
        <obo:IAO_0000115 xml:lang="en">A product added to a food item to achieve some degree of sweet taste; it may be nutritive or nonnutritive.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0237"/>
        <rdfs:label xml:lang="en">sweetener (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Fruits and vegetables in all forms. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0257"/>
        <rdfs:label xml:lang="en">fruit or vegetable product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400306"/>
        <obo:IAO_0000115 xml:lang="en">Nuts in all forms, including nut butters and pastes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0260"/>
        <rdfs:label xml:lang="en">nut or nut product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Fresh egg in shell, liquid, frozen, dried egg or egg component, or egg product analog. Includes boiled, poached, scrambled, and fried eggs. Excludes prepared egg dishes, such as omelettes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0261"/>
        <rdfs:label xml:lang="en">egg or egg product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400152"/>
        <obo:IAO_0000115 xml:lang="en">The liquid extracted or expressed from mature vegetables with or without optional ingredients such as seasoning or salt.  Products prepared from vegetable juice by thickening with gelatin or pectin are indexed under the broader term *VEGETABLE OR VEGETABLE PRODUCT*. For part or portion, index the part or the plant from which the juice was extracted, rather than *PLANT EXTRACT, CONCENTRATE, OR ISOLATE*.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0264"/>
        <oboInOwl:hasSynonym xml:lang="en">juice, vegetable</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">vegetable juice (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400217"/>
        <obo:IAO_0000115 xml:lang="en">Flesh from fish or shellfish. Includes seafood product analogs and seafood-based sausage or luncheon meat as well as such products as squid ink and clam juice.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0267"/>
        <rdfs:label xml:lang="en">seafood or seafood product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03401270"/>
        <obo:IAO_0000115 xml:lang="en">Any form of cacao, cacao product, chocolate, chocolate product or chocolate product analog except chocolate candy; includes such products as cacao beans, cacao nibs, chocolate liquor, sweet or milk chocolate, and chocolate syrup; excludes flavors and extracts derived from cacao beans and chocolate- or cacao-flavored foods (21 CFR 163). [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0272"/>
        <oboInOwl:hasSynonym xml:lang="en">chocolate or cacao product</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">cacao or chocolate product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400229"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001579"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Beverage containing more than 0.5% alcohol; includes distilled spirits, malt beverage, and wine.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0278"/>
        <rdfs:label xml:lang="en">alcoholic beverage (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400289 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400361"/>
        <obo:IAO_0000115 xml:lang="en">Food group having common consumption, functional or manufacturing characteristics, e.g. *FRUIT OR VEGETABLE PRODUCT*, *DAIRY PRODUCT*, *CONFECTIONARY*, *PREPARED FOOD PRODUCT*, etc. [FDA CFSAN 1995]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0289"/>
        <rdfs:comment xml:lang="en">LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term.</rdfs:comment>
        <rdfs:label xml:lang="en">USA agency food product type</rdfs:label>
    </owl:Class>
    


