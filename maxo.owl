    <!-- http://purl.obolibrary.org/obo/MAXO_0000694 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000680"/>
        <obo:IAO_0000115>An assessment by an internist who treats diseases of joints, muscle, bones and tendons. This specialist diagnoses and treats arthritis, back pain, muscle strains, common athletic injuries and collagen diseases.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-02T19:00:04Z</dce:date>
