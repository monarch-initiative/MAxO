        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>electrotonic synapse</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao1311109124</oboInOwl:hasDbXref>
    </owl:Axiom>
    


