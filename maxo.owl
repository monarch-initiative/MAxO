        <oboInOwl:hasDbXref>NCIT:C15416</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VO:0000491</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">active immunization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000120"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Active immunity refers to the process of exposing the body to an antigen to generate an adaptive immune response: the response takes days/weeks to develop but may be long lasting—even lifelong.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18045976</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000118"/>
        <obo:IAO_0000115>Passive immunity refers to the process of providing IgG antibodies to protect against infection; it gives immediate, but short-lived protection.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-20T00:31:52Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
