        <oboInOwl:hasRelatedSynonym>lateral lingual prominence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lateral swellings</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tuberculum laterale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tuberculum linguale laterale</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lateral lingual swelling</rdfs:label>
