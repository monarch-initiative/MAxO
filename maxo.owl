    <!-- http://purl.obolibrary.org/obo/MAXO_0000750 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000647"/>
        <obo:IAO_0000115>Administration of high doses of chemotherapy or radiation therapy, as well as immunosuppressive therapy, to a transplant recipient prior to a bone marrow or hematopoietic stem cell transplant.  Conditioning destroys the patient&apos;s abnormal blood cells or cancer, as well as slows the patient&apos;s immune response against the donor bone marrow (graft rejection).</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-19T20:12:40Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
