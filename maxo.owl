    <!-- http://purl.obolibrary.org/obo/UBERON_0008969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007499"/>
