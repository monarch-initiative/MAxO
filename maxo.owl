        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001443"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001514"/>
        <rdfs:subClassOf>
            <owl:Restriction>
