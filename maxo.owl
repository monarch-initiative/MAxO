        <oboInOwl:hasExactSynonym>evaluation by sleep specialist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>referral to sleep medicine specialist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>referral to sleep specialist</oboInOwl:hasExactSynonym>
