    <!-- http://purl.obolibrary.org/obo/MAXO_0000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000003"/>
        <obo:IAO_0000115>The use of any device, marker, or other means for the purpose of detecting the presence of disease, usually in asymptomatic individuals.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-20T00:39:19Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
