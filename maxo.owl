        <obo:IAO_0000115>Specialized cardiac myocyte which is in the internodal tract and atrioventricular node. The cell is more slender than ordinary atrial myocytes and has more myofibrils than nodal myocytes.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:hasDbXref>FMA:67142</oboInOwl:hasDbXref>
