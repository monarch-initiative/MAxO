        <owl:annotatedTarget>membrane organisation</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mah</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0061024"/>
