                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A plant fruit food product which is labeled (in common language or by regulation) as a vegetable food product.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">plant fruit as vegetable food product</rdfs:label>
    </owl:Class>
    


