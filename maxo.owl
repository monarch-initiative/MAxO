        <oboInOwl:hasRelatedSynonym>non-steroidal anti-inflammatory drugs</oboInOwl:hasRelatedSynonym>
        <rdfs:label>non-steroidal anti-inflammatory drug</rdfs:label>
    </owl:Class>
