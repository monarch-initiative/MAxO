    <!-- http://purl.obolibrary.org/obo/MAXO_0000908 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000648"/>
