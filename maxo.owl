        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000712"/>
        <obo:IAO_0000115>An assesment  a specialist focuses on preventing, diagnosing, and treating injuries related to participating in sports and/or exercise. In addition to the study of those fields that focus on prevention, diagnosis, treatment, and management of injuries, Sports Medicine specialists also deal with illnesses and diseases that might have effects on health and physical performance.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-01T19:59:07Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
