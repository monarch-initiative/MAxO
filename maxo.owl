            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A planned process with the objective of collecting a specimen.</obo:IAO_0000115>
        <rdfs:label>specimen collection process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000832 -->

