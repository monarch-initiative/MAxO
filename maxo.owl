        <oboInOwl:hasDbXref>ZFA:0000529</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Wolffian body</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesonephric kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesonephroi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>amphibian adult kidney</oboInOwl:hasRelatedSynonym>
