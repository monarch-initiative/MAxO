        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0098802"/>
        <obo:IAO_0000115>An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>B lymphocyte receptor complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B-cell receptor complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B-lymphocyte receptor complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BCR complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>immunoglobulin complex, membrane bound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>B cell receptor accessory molecule complex</oboInOwl:hasRelatedSynonym>
