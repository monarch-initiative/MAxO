        <oboInOwl:hasExactSynonym>radionuclide scanning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>scintigraphy</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">nuclear medicine imaging procedure</rdfs:label>
    </owl:Class>
    


