        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000457"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000458"/>
        <obo:IAO_0000115>Thermal hydrotherapy uses external or internal use of water in any of its forms (water, ice, steam) at temperatures above or below room temperature for health promotion or treatment of various diseases with various temperatures, pressure, duration, and site.</obo:IAO_0000115>
