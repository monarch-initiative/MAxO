        <rdfs:comment>Note that an immunoglobulin complex has the function of antigen binding if a suitable antigen is available.</rdfs:comment>
        <rdfs:label>B cell receptor complex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0019815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
