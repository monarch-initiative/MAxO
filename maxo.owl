    <!-- http://purl.obolibrary.org/obo/MAXO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000026"/>
        <obo:IAO_0000115>A form of deep heat therapy can induce vasodilatation, elevation of pain threshold, reduction in muscle spasm, acceleration of cellular metabolism, increased soft tissue extensibility, increase blood flow, decrease joint pain and stiffness, reduce inflammation, faster resolution of edema, and accelerate wound healing.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-03-02T20:15:39Z</dce:date>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>SWD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>radio-frequency diathermy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>short-wave diathermy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shortwave diathermy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>radio frequency heating</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">short wave diathermy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000030"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A form of deep heat therapy can induce vasodilatation, elevation of pain threshold, reduction in muscle spasm, acceleration of cellular metabolism, increased soft tissue extensibility, increase blood flow, decrease joint pain and stiffness, reduce inflammation, faster resolution of edema, and accelerate wound healing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31748973</oboInOwl:hasDbXref>
    </owl:Axiom>
    


