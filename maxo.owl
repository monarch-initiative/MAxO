        <oboInOwl:hasDbXref>VHOG:0001266</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Placenta</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>allantoic placenta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>eutherian placenta</oboInOwl:hasExactSynonym>
        <rdfs:comment>Marsupials possess only a rudimentary yolk-type placenta, with reduced nutrient and oxygen exchanging capabilities.</rdfs:comment>
        <rdfs:label>placenta</rdfs:label>
    </owl:Class>
    <owl:Axiom>
