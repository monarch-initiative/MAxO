        <oboInOwl:hasDbXref>FMA:14515</oboInOwl:hasDbXref>
        <rdfs:comment>Hepatocytes are reportedly MHC Class I-positive and MHC Class II-positive.</rdfs:comment>
        <rdfs:label>hepatocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
