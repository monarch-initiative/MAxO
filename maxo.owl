        <owl:annotatedTarget>The use of operant conditioning, including rewards and punishments, in helping a person create an atmosphere where he or she does not contribute to painful stimuli.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C15184</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000883 -->

