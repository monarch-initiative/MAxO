            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An external organ of a male organism that is specialized to deliver sperm during copulation. Intromittent organs are found most often in terrestrial species, as most aquatic species fertilize their eggs externally, although there are exceptions[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0010255</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HAO:0000091</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0002036</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0000585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Intromittent_organ</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>aedeagus</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>penis</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>copulatory organ</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intromittent organ</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008811"/>
