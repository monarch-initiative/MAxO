    <!-- http://purl.obolibrary.org/obo/MAXO_0000448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000447"/>
        <obo:IAO_0000115>Surgical removal (cutting out or off) without replacement of all of a body part or structure.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-27T17:45:26Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>resection</oboInOwl:hasExactSynonym>
