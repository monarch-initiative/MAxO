    <!-- http://purl.obolibrary.org/obo/MAXO_0000692 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000692">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000680"/>
        <obo:IAO_0000115>An assessment by an internist who treats disorders of the kidney, high blood pressure, fluid and mineral balance, and dialysis of body wastes when the kidneys do not function. This specialist consults with surgeons about kidney transplantation.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-02T18:23:18Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
