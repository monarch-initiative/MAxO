    <!-- http://purl.obolibrary.org/obo/MAXO_0009096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0009096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000058"/>
        <obo:IAO_0000115>Use of a drug that inhibits Janus kinases.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-08-17T19:11:56Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>JAK inhibitor therapy</oboInOwl:hasExactSynonym>
        <rdfs:comment>Janus kinase (JAK) Inhibitors are the latest drug class of disease-modifying medication to emerge for the treatment of rheumatoid arthritis (RA). They are a small molecule-targeted treatment and are the first oral option to compare favourably to existing biologic disease-modifying anti-rheumatic drugs (DMARDs).</rdfs:comment>
        <rdfs:label xml:lang="en">Janus kinase inhibitor therapy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0009096"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Janus kinase (JAK) Inhibitors are the latest drug class of disease-modifying medication to emerge for the treatment of rheumatoid arthritis (RA). They are a small molecule-targeted treatment and are the first oral option to compare favourably to existing biologic disease-modifying anti-rheumatic drugs (DMARDs).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32982367</oboInOwl:hasDbXref>
    </owl:Axiom>
    


