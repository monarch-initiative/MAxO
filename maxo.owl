        <oboInOwl:hasDbXref>PMID:20065995</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20200518</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0042092"/>
