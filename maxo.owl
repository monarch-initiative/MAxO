        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-06-27T22:43:12Z</dcterms:date>
        <oboInOwl:hasBroadSynonym xml:lang="en">palaeoheterodonta</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">pteriomorphia</oboInOwl:hasBroadSynonym>
