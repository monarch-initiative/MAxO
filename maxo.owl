    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002086"/>
        <obo:IAO_0000115>A specialized cardiac myocyte in the sinoatrial and atrioventricular nodes. The cell is slender and fusiform confined to the nodal center, circumferentially arranged around the nodal artery.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:hasBroadSynonym>pacemaker cell</oboInOwl:hasBroadSynonym>
