    <!-- http://purl.obolibrary.org/obo/MAXO_0000729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0010210"/>
        <obo:IAO_0000115>A procedure that uses sound waves to create a video image of the pelvic organs and tissues. A small, lubricated probe placed into the rectum releases sound waves, which create echoes as they enter a pelvic organ. The echoes that bounce back are sent to a computer that translates the pattern of echoes into a picture of the specific organ under examination.  This procedure is most often used to evaluate the prostate gland.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-16T14:46:48Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasDbXref>NCIT:C18315</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ERUS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>TRUS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diagnostic transrectal ultrasound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endorectal sonography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endorectal ultrasound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endorectal ultrsonography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>medical transrectal ultrasound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>transrectal sonography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>transrectal ultrasound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>transrectal ultrasound examination</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">transrectal ultrasonography</rdfs:label>
    </owl:Class>
