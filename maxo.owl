        <oboInOwl:hasExactSynonym>referral to a sports medicine specialist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sports medicine specialist consultation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">sports medicine specialist evaluation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An assesment  a specialist focuses on preventing, diagnosing, and treating injuries related to participating in sports and/or exercise. In addition to the study of those fields that focus on prevention, diagnosis, treatment, and management of injuries, Sports Medicine specialists also deal with illnesses and diseases that might have effects on health and physical performance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>abms.org</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000667"/>
