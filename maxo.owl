        <oboInOwl:hasExactSynonym>hormonal regulation of blood pressure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>hormonal control of blood pressure</oboInOwl:hasRelatedSynonym>
        <rdfs:label>regulation of systemic arterial blood pressure by hormone</rdfs:label>
    </owl:Class>
