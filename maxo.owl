    <!-- http://purl.obolibrary.org/obo/UBERON_0003890 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000025"/>
