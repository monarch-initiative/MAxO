        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411297"/>
        <obo:IAO_0000115 xml:lang="en">A gill-bearing aquatic craniate animal that lacks limbs with digits.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B1222"/>
        <rdfs:comment xml:lang="en">&quot;Most fish are ectothermic (&apos;cold-blooded&apos;), allowing their body temperatures to vary as ambient temperatures change, though some of the large active swimmers like white shark and tuna can hold a higher core temperature.&quot; - https://en.wikipedia.org/wiki/Fish</rdfs:comment>
