        <rdfs:label>image creation device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A needle is a sharp, hollow device used to penetrate tissue or soft material. When attached to a syringe. it allows delivery of a specific volume of liquid or gaseous mixture.</obo:IAO_0000115>
        <rdfs:label>needle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000659 -->

