        <oboInOwl:hasDbXref>NCIT:C126400</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>RRT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>kidney replacement therapy</oboInOwl:hasExactSynonym>
        <rdfs:comment>It includes dialysis (hemodialysis or peritoneal dialysis), hemofiltration, and hemodiafiltration. Kidney transplant may also be considered a renal replacement therapy.</rdfs:comment>
        <rdfs:label xml:lang="en">renal replacement therapy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000600"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
