        <oboInOwl:hasDbXref>Wikipedia:Conceptus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryo plus adnexa</oboInOwl:hasExactSynonym>
        <rdfs:label>conceptus</rdfs:label>
