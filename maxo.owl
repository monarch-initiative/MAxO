        <oboInOwl:hasExactSynonym>cardiac pacemaker cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myocytus nodalis</oboInOwl:hasExactSynonym>
        <rdfs:label>nodal myocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002072"/>
