        <oboInOwl:hasRelatedSynonym>nucleocytoplasm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>protoplast</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intracellular anatomical structure</rdfs:label>
