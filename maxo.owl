    <!-- http://purl.obolibrary.org/obo/MAXO_0001318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0001318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001316"/>
        <obo:IAO_0000115>This test consists of injecting indocyanine green dye (ICG) through a peripheral intravenous line. The ICG subsequently binds to blood lipoproteins and travels to where there is blood flow. Using a near-infrared laser coupled with a camera, one can then visualize blood flow within 3–5 millimeters of the skin surface.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-02-21T19:02:21Z</dce:date>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0001-7941-2961"/>
        <rdfs:comment>This technique can be used as a bedside diagnosis for frostbite</rdfs:comment>
        <rdfs:label xml:lang="en">fluorescent microangiography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001318"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>This test consists of injecting indocyanine green dye (ICG) through a peripheral intravenous line. The ICG subsequently binds to blood lipoproteins and travels to where there is blood flow. Using a near-infrared laser coupled with a camera, one can then visualize blood flow within 3–5 millimeters of the skin surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:36409932</oboInOwl:hasDbXref>
    </owl:Axiom>
    


