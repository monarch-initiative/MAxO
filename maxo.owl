        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A chemical compound that can be excited by light of a specific wavelength and subsequently transfer energy to a chosen reactant. This is commonly molecular oxygen within a cancer tissue, which is converted to (highly rective) singlet state oxygen. This rapidly reacts with any nearby biomolecules, ultimately killing the cancer cells.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>photosensitising agent</oboInOwl:hasRelatedSynonym>
        <rdfs:label>photosensitizing agent</rdfs:label>
    </owl:Class>
