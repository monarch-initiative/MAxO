    <!-- http://purl.obolibrary.org/obo/MAXO_0000588 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000006"/>
        <obo:IAO_0000115>A technique that detects a particular nucleic acid sequence in order to identify a pathogen (organism or virus) in blood, tissue, urine, or other bodily fluids.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-02T20:59:07Z</dce:date>
