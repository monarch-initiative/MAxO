            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A subclass of polyketides having an octahydrotetracene-2-carboxamide skeleton, substituted with many hydroxy and other groups.</obo:IAO_0000115>
        <rdfs:label>tetracyclines</rdfs:label>
    </owl:Class>
    


