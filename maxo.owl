        <oboInOwl:hasExactSynonym>mammography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>radiograph of breast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>radiography of breast</oboInOwl:hasExactSynonym>
        <rdfs:label>mammography procedure</rdfs:label>
    </owl:Class>
    


