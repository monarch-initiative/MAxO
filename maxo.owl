    <!-- http://purl.obolibrary.org/obo/MAXO_0000697 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000665"/>
        <obo:IAO_0000115>An assessment with a specialist who directs and interprets a wide range of specialized, laboratory biochemical genetic analyses relevant to the diagnosis and management of inherited metabolic disorders. The specialist acts as a consultant regarding laboratory diagnosis on a broad range of inborn errors of metabolism.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-02T20:14:07Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
