        <oboInOwl:hasRelatedSynonym>acides gras</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acido graso</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acidos grasos</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fatty acids</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fatty acid</rdfs:label>
    </owl:Class>
