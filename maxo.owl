    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000889 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000890"/>
        <obo:IAO_0000115>Removal of hard deposits made of minerals and salts also called &apos;kidney stones&apos; or &apos;renal calculi&apos; by any of a number of methods.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T16:22:26Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>kidney stone removal</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">renal calculi removal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000890 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000885"/>
        <obo:IAO_0000115>Removal of hard deposits made of minerals and salts also called &apos;stones&apos; or &apos;calculi&apos; by any of a number of methods. Stones can be found in the kidney, gallbladder, urethra, salivary gland or other ducts.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T16:46:18Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>stone removal</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">calculi removal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000890"/>
        <obo:IAO_0000115>A procedure to break a stone into small particles that can be more easily cleared from the body.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T17:17:19Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasDbXref>NCIT:C51994</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">lithotripsy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000891"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A procedure to break a stone into small particles that can be more easily cleared from the body.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C51994</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000892 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000889"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000891"/>
        <obo:IAO_0000115>A treatment to remove kidney snotes by sending ultrasonic energy/shock waves directly to the stone.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T17:20:00Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>kidney lithotripsy</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">renal lithotripsy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000893 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000891"/>
        <obo:IAO_0000115>A scope is inserted in the urinary tract to locate the stone. Using an optical fiber, laser light is directly emitted to the stone causing stone fragmentation.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T17:21:56Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <rdfs:label xml:lang="en">laser lithotripsy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000894 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000891"/>
        <obo:IAO_0000115>Using a lithotripter to aim sound waves directly at stones through the body, the shock waves break down stones or calculi which are then able to pass.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T17:22:14Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>ESWL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>extracorporeal shock-wave lithotripsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shock wave lithotripsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shock-wave lithotripsy</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">extracorporeal shock wave lithotripsy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000894"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ESWL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000889"/>
        <obo:IAO_0000115>A small cut is made through the patient&apos;s back and a nephroscope is inserted to locate and remove the kidney stone.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T18:17:54Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <rdfs:label xml:lang="en">percutaneous nephrolithotomy</rdfs:label>
    </owl:Class>
    


