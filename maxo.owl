        <oboInOwl:hasExactSynonym>tracheotomy</oboInOwl:hasExactSynonym>
        <rdfs:comment>Tracheostomy and tracheotomy are sometimes used interchangeably, but tracheotomy is simply a surgical incision of the trachea.</rdfs:comment>
        <rdfs:label>tracheostomy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000506"/>
        <obo:IAO_0000115>A manual method for maintaining oxygenation using a mask.</obo:IAO_0000115>
