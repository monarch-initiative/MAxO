        <oboInOwl:hasRelatedSynonym>trilaminar disk stage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trilaminar germ stage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trilaminar stage</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gastrula stage</rdfs:label>
    </owl:Class>
