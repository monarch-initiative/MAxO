    <!-- http://purl.obolibrary.org/obo/MAXO_0000473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000451"/>
        <obo:IAO_0000115>The implantation of a piece of mechanical or electronic equipment that is useful for prevention, diagnosis, monitoring, or treatment of disease or other conditions.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-20T14:58:18Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasDbXref>ERO:0001092</oboInOwl:hasDbXref>
