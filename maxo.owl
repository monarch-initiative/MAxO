        <oboInOwl:hasDbXref>http://life.nthu.edu.tw/~g864204/dict-search1.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0030879 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0030879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048732"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the mammary gland over time, from its formation to the mature structure. The mammary gland is a large compound sebaceous gland that in female mammals is modified to secrete milk. Its development starts with the formation of the mammary line and ends as the mature gland cycles between nursing and weaning stages.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>mammogenesis</oboInOwl:hasNarrowSynonym>
        <rdfs:label>mammary gland development</rdfs:label>
    </owl:Class>
