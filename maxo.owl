    <!-- http://purl.obolibrary.org/obo/MAXO_0000949 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000015"/>
        <obo:IAO_0000115>Treatment with a hormone that is naturally produced in the thyroid. When calcitonin given to patients with osteoporosis, calcitonin produces modest increases in bone mass because it slows the rate at which osteoclasts absorb bone.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-12T19:57:09Z</dce:date>
