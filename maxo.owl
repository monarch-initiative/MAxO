    <!-- http://purl.obolibrary.org/obo/UBERON_8600004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_8600004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
