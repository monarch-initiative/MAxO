        <oboInOwl:hasDbXref>NCIT:C124040</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CPAP ventilation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>nCPAP ventilation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>nasal continuous positive airway pressure ventilation</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">continuous positive airway pressure ventilation</rdfs:label>
    </owl:Class>
