    <!-- http://purl.obolibrary.org/obo/GO_0021915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0035295"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0060429"/>
