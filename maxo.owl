        <owl:annotatedTarget>class 1 G-protein coupled receptor</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:15914470</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
