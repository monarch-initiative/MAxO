        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Administration of high doses of chemotherapy or radiation therapy, as well as immunosuppressive therapy, to a transplant recipient prior to a bone marrow or hematopoietic stem cell transplant.  Conditioning destroys the patient&apos;s abnormal blood cells or cancer, as well as slows the patient&apos;s immune response against the donor bone marrow (graft rejection).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C64468</oboInOwl:hasDbXref>
    </owl:Axiom>
    


