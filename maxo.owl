        <oboInOwl:hasDbXref>ncithesaurus:Spermatogenic_Cell</oboInOwl:hasDbXref>
        <rdfs:label>male germ cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000015"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
