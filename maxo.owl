    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23229"/>
