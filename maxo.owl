        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000429"/>
        <obo:IAO_0000115>A procedure that delivers a single, highly concentrated dose of ionizing radiation from an external source to a small, precise target using 3-D computerized imaging to focus beams. There is no incision, but this technique distorts and destroys the DNA of tumor cells in a highly directed fashion.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-06-17T19:33:11Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
