            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that activates or increases the frequency, rate or extent of a biological process. Biological processes are regulated by many means; examples include the control of gene expression, protein modification or interaction with a protein or substrate molecule.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>positive regulation of physiological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>up regulation of biological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>up-regulation of biological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>upregulation of biological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>activation of biological process</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>stimulation of biological process</oboInOwl:hasNarrowSynonym>
        <rdfs:label>positive regulation of biological process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that activates or increases the frequency, rate or extent of a biological process. Biological processes are regulated by many means; examples include the control of gene expression, protein modification or interaction with a protein or substrate molecule.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jid</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0048519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050789"/>
