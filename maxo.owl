    <!-- http://purl.obolibrary.org/obo/MAXO_0020000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0020000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001625"/>
        <obo:IAO_0000115>Intravenous infusion with coagulation factor VIII.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Deficiency of the coagulation cofactor factor VIII (FVIII) leads to the X‐chromosomal inherited bleeding disorder hemophilia A. Current therapy for hemophilia is based on the infusion of clotting factor concentrates either at the time of bleeding (on demand therapy) or in a prophylactic schedule to prevent bleeding episodes.</rdfs:comment>
        <rdfs:label>coagulation factor VIII replacement therapy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0020000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Intravenous infusion with coagulation factor VIII.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:23809113</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0020001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0020001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001625"/>
        <obo:IAO_0000115>Intravenous infusion with coagulation factor IX.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <rdfs:comment>Deficiency of the coagulation cofactor factor IX (FIX) leads to the X‐chromosomal inherited bleeding disorder hemophilia B. Current therapy for hemophilia is based on the infusion of clotting factor concentrates either at the time of bleeding (on demand therapy) or in a prophylactic schedule to prevent bleeding episodes.</rdfs:comment>
        <rdfs:label>coagulation factor IX replacement therapy</rdfs:label>
    </owl:Class>
    


