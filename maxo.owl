        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115>A protein with four transmembrane domains, small intracellular amino- and carboxyl-terminal regions, and two extracellular loops, a small one (EC1) and a larger one (EC2) of about 100 residues. The EC2 loop contains at least 4 cysteine residues, including a highly conserved &apos;CCG&apos; motif.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PIRSF:PIRSF002419</oboInOwl:hasDbXref>
        <rdfs:comment>Category=family.</rdfs:comment>
