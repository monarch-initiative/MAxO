        <oboInOwl:hasBroadSynonym>erythropoietin therapy</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>CHEBI:81579</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C477</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ESA therapy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hematopoietin treatment therapy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>recombinant EPO treatment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>recombinant erythropoietin drug therapy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>recombinant erythropoietin treatment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>treatment with erythropoietin stimulating agent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>treatment with erythropoietin stimulating medication</oboInOwl:hasExactSynonym>
