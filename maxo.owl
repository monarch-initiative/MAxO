    <!-- http://purl.obolibrary.org/obo/CL_0002068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002086"/>
        <obo:IAO_0000115>Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:hasDbXref>BTO:0001032</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:14146</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Purkinje cell fiber</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Purkinje muscle cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myocytus conducens cardiacus</oboInOwl:hasExactSynonym>
        <rdfs:label>Purkinje myocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
