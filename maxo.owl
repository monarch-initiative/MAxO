        <owl:annotatedTarget>synovium</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CALOHA:TS-0998</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>stratum synoviale</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:TA</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>synovial layer</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:66762</oboInOwl:hasDbXref>
