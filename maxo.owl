    <!-- http://purl.obolibrary.org/obo/PR_000001013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000001005"/>
        <obo:IAO_0000115>An integrin alpha with A domain that is a translation product of the human ITGAX gene or a 1:1 ortholog thereof. Integrin alpha-X complexed with beta-2 is a receptor for fibrinogen. It recognizes the sequence GPR in fibrinogen. It mediates cell-cell interaction during inflammatory responses. It is especially important in monocyte adhesion and chemotaxis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>IUPHARobj:2454</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CD11 antigen-like family member C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD11c</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ITGAX</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Leu M5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leukocyte adhesion glycoprotein p150,95 alpha chain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leukocyte adhesion receptor p150,95</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>CD11C</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Category=gene. Requested by=CL.</rdfs:comment>
        <rdfs:label>integrin alpha-X</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PR_000001013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An integrin alpha with A domain that is a translation product of the human ITGAX gene or a 1:1 ortholog thereof. Integrin alpha-X complexed with beta-2 is a receptor for fibrinogen. It recognizes the sequence GPR in fibrinogen. It mediates cell-cell interaction during inflammatory responses. It is especially important in monocyte adhesion and chemotaxis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UniProtKB:P20702</oboInOwl:hasDbXref>
