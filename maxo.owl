    <!-- http://purl.obolibrary.org/obo/MAXO_0035096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0035096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000003"/>
        <obo:IAO_0000115>The hydrogen breath test is a noninvasive procedure to diagnose dietary intolerance (e.g., lactose or galactose intolerance) and related conditions by measuring the amount of hydrogen exhaled in the breath following ingestion of the relevant sugar.</obo:IAO_0000115>
        <dce:date>2023-04-11T12:00:00Z</dce:date>
