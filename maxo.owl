        <owl:annotatedTarget>A quality inhering in a bearer by virtue of the bearer&apos;s being abnormal and having a destructive effect on living tissue.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:cjm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0015011"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000411"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A convex 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s exhibiting a consistently-sized round cross section.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>rod-like</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rod-shaped</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>tubulate</oboInOwl:hasNarrowSynonym>
        <rdfs:label>cylindrical</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001873"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A convex 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s exhibiting a consistently-sized round cross section.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:MAH</oboInOwl:hasDbXref>
