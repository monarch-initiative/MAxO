        <oboInOwl:hasExactSynonym>taste</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>taste perception</oboInOwl:hasExactSynonym>
        <rdfs:label>sensory perception of taste</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0050909"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
