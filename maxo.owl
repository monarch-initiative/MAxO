        <obo:IAO_0000115>A transcript that in its initial state requires modification to be functional.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Primary_transcript</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>INSDC_feature:precursor_RNA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>INSDC_feature:prim_transcript</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>precursor RNA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primary transcript</oboInOwl:hasExactSynonym>
        <rdfs:label>primary_transcript</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A transcript that in its initial state requires modification to be functional.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:ma</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SO_0000185"/>
