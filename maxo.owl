            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002495"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010532"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The basic functional unit of the kidney. its chief function is to regulate the concentration of water and soluble substances like sodium salts by filtering the blood, reabsorbing what is needed and excreting the rest as urine. A nephron eliminates wastes from the body, regulates blood volume and blood pressure, controls levels of electrolytes and metabolites, and regulates blood pH. Its functions are vital to life and are regulated by the endocrine system by hormones such as antidiuretic hormone, aldosterone, and parathyroid hormone.[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000924</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-1312</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:28491</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35592</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100384</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:17640</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000375</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D009399</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C13048</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361337001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0002153</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Nephron</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005282</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>mature nephron</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>nephroneum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tubulus renalis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nephron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001285"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The basic functional unit of the kidney. its chief function is to regulate the concentration of water and soluble substances like sodium salts by filtering the blood, reabsorbing what is needed and excreting the rest as urine. A nephron eliminates wastes from the body, regulates blood volume and blood pressure, controls levels of electrolytes and metabolites, and regulates blood pH. Its functions are vital to life and are regulated by the endocrine system by hormones such as antidiuretic hormone, aldosterone, and parathyroid hormone.[WP].</owl:annotatedTarget>
