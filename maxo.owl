        <oboInOwl:hasExactSynonym>referral to cardiovascular disease internist</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">cardiologist evaluation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000682"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An assessment by an internist who specializes in diseases of the heart and blood vessels and manages complex cardiac conditions, such as heart attacks and life-threatening, abnormal heartbeat rhythms.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>abms.org</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000683 -->

