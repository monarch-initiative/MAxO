        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0009584"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The series of events in which a visible light stimulus is received by a cell and converted into a molecular signal. A visible light stimulus is electromagnetic radiation that can be perceived visually by an organism; for organisms lacking a visual system, this can be defined as light with a wavelength within the range 380 to 780 nm.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:go_curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0198506732</oboInOwl:hasDbXref>
