        <owl:annotatedTarget>glomerular epithelial cell</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BTO:0001515</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0004198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004198">
