    <!-- http://purl.obolibrary.org/obo/MAXO_0000593 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000589"/>
        <obo:IAO_0000115>A clinical assay that amplifies and quantifies a specific DNA molecule based on in tissue, blood, sputum, urine, or any other bodily fluid to detect the presence of a pathogen.  It enables both detection and quantification of one or more specific sequences in a DNA sample.</obo:IAO_0000115>
