    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001479"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005893"/>
