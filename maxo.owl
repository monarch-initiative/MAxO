        <obo:IAO_0000115 xml:lang="en">A soybean food product is a product derived from the soybean plant.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">soy product</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">soybean food product</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002271">
