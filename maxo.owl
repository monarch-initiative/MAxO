        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000512 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000509"/>
        <obo:IAO_0000115>A form of non-invasive mechanical pressure support ventilation that uses a continuous positive airway pressure level to support spontaneous breathing activity.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-23T18:31:36Z</dce:date>
