        <owl:annotatedTarget>The measurement of the ratio of oxygenated hemoglobin to total hemoglobin in the blood.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C60832</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000617 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000616"/>
        <obo:IAO_0000115>A non-invasive method that provides estimates of arterial oxyhemoglobin saturation by utilizing selected wavelengths of light to determine the saturation of oxyhemoglobin.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-08T18:54:34Z</dce:date>
