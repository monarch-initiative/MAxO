    <!-- http://purl.obolibrary.org/obo/MAXO_0000693 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000680"/>
        <obo:IAO_0000115>An assessment by an internist who treats diseases of the lungs and airways. The specialist diagnoses and treats cancer, pneumonia, pleurisy, asthma, occupational and environmental diseases, bronchitis, sleep disorders, emphysema and other complex disorders of the lungs.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-02T18:32:06Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
