        <oboInOwl:hasExactSynonym>osteogenesis</oboInOwl:hasExactSynonym>
        <rdfs:comment>Note that this term does not have a &apos;developmental process&apos; parent because ossification isn&apos;t necessarily developmental, can also occur as part of bone remodeling. Instead use &apos;ossification involved in bone maturation ; GO:0043931&apos;.</rdfs:comment>
        <rdfs:label>ossification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0001503"/>
