        <rdfs:label>jerk-locked averaging</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0035064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0035064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000005"/>
        <obo:IAO_0000115>The transmission electron microscope (TEM) is a diagnostic tool to screen human tissues at high magnification to visualize the ultrastructural level.</obo:IAO_0000115>
        <dce:date>2023-04-11T12:00:00Z</dce:date>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
