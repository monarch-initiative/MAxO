        <oboInOwl:hasBroadSynonym>lymphoid progenitor cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BTO:0004731</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-2025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:70338</oboInOwl:hasDbXref>
