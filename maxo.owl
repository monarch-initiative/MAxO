    <!-- http://purl.obolibrary.org/obo/GO_0001501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048731"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the skeleton over time, from its formation to the mature structure. The skeleton is the bony framework of the body in vertebrates (endoskeleton) or the hard outer envelope of insects (exoskeleton or dermoskeleton).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>skeletal development</oboInOwl:hasExactSynonym>
        <rdfs:label>skeletal system development</rdfs:label>
    </owl:Class>
