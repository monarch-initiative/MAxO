                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that modulates the rate frequency or extent of cilium movement involved in ciliary motility.</obo:IAO_0000115>
        <rdfs:label>regulation of cilium movement involved in cell motility</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0060295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
