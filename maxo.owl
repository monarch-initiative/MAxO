                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that stops, prevents, or reduces the frequency, rate or extent of a biological process. Biological processes are regulated by many means; examples include the control of gene expression, protein modification or interaction with a protein or substrate molecule.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>down regulation of biological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>down-regulation of biological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>downregulation of biological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>negative regulation of physiological process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>inhibition of biological process</oboInOwl:hasNarrowSynonym>
        <rdfs:label>negative regulation of biological process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048519"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that stops, prevents, or reduces the frequency, rate or extent of a biological process. Biological processes are regulated by many means; examples include the control of gene expression, protein modification or interaction with a protein or substrate molecule.</owl:annotatedTarget>
