        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000487"/>
        <obo:IAO_0000115>A type of cardiac test in which the patient walks on a treadmill or rides a stationary bike, while cardiovascular parameters such as heart rhythm, blood pressure and breathing are measured.</obo:IAO_0000115>
        <dce:date>2023-04-11T12:00:00Z</dce:date>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0001-7941-2961"/>
        <rdfs:label>cardiac exercise stress test</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0035118 -->

