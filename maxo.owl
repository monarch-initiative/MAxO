        <oboInOwl:hasDbXref>NCIT:C32316</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361733004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Petrous_part_of_the_temporal_bone</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pars petrosa (os temporale)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pars petrosa ossis temporalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>petromastoid part of temporal bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>temporal bone petrous part</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>petrosal bone</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>petrous bone</oboInOwl:hasRelatedSynonym>
        <rdfs:label>petrous part of temporal bone</rdfs:label>
    </owl:Class>
