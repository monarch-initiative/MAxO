        <oboInOwl:hasDbXref>NCIT:C92755</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CVS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chorionic villus biopsy</oboInOwl:hasExactSynonym>
        <rdfs:comment>The biopsy of placental tissue containing the chorionic villi from the maternal uterus in early pregnancy to diagnose fetal genetic defects.</rdfs:comment>
        <rdfs:label>chorionic villus sampling</rdfs:label>
    </owl:Class>
