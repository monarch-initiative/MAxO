            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any of the immature or mature forms of a granular leukocyte that in its mature form has a nucleus with three to five lobes connected by slender threads of chromatin, and cytoplasm containing fine inconspicuous granules and stainable by neutral dyes.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>PMN</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>poly</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>polymorphonuclear leucocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>polymorphonuclear leukocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>polymorphonuclear neutrophil</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>polynuclear neutrophilic leucocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>polynuclear neutrophilic leukocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BTO:0000130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0688</oboInOwl:hasDbXref>
