        <rdfs:label xml:lang="en">nut or seed product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400308 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400309"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=A0308"/>
        <rdfs:label xml:lang="en">supplemental formulation (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03400172"/>
