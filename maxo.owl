        <oboInOwl:hasDbXref>NCIT:C34312</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001081</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000444</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001081</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>thyroid primordia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thyroid primordium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003091"/>
