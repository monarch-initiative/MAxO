    <!-- http://purl.obolibrary.org/obo/MAXO_0000600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000002"/>
        <obo:IAO_0000115>Treatments that substitute for the blood-filtering function of the kidneys.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-07T19:42:23Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
