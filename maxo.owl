        <oboInOwl:hasExactSynonym>HRME</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">high-resolution microendoscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000136"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A low-cost, high-resolution imaging tool consisting of a 1-mm diameter fiber-optic bundle that produces subcellular imaging at 1,000x magnification and 4 micrometer resolution, allowing for minimally invasive bioimaging.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C116480</oboInOwl:hasDbXref>
    </owl:Axiom>
