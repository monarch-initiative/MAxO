    <!-- http://purl.obolibrary.org/obo/UBERON_0001175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003703"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
