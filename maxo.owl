        <oboInOwl:hasExactSynonym>water therapy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>water cure</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">hydrotherapy</rdfs:label>
    </owl:Class>
