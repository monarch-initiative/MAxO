        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which vesicles are directed to specific destination membranes during transport to, from or within the Golgi apparatus; mediated by the addition of specific coat proteins, including COPI and COPII proteins and clathrin, to the membrane during vesicle formation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Golgi vesicle targeting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>dictyosome vesicle targeting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>vesicle targeting, to, from or within dictyosome</oboInOwl:hasNarrowSynonym>
        <rdfs:label>vesicle targeting, to, from or within Golgi</rdfs:label>
    </owl:Class>
    <owl:Axiom>
