        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <obo:IAO_0000115>X extends_fibers into Y iff there exists some neuron (N) and N has_soma_location X and N &apos;has synaptic IO in region&apos; some Y</obo:IAO_0000115>
        <rdfs:label>extends_fibers_into</rdfs:label>
    </owl:ObjectProperty>
