    <!-- http://purl.obolibrary.org/obo/MAXO_0000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000132"/>
        <obo:IAO_0000115>An endoscopic technique that allows deep intubation of the small intestine while using a standard endoscope. An inflatable balloon attached to the endoscope&apos;s tip acts as a stabilizer and a second balloon that is advanced ahead of the endoscope acts as a pulling device.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-20T18:48:29Z</dce:date>
