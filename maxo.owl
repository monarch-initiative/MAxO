        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001042"/>
        <obo:IAO_0000115>A surgical procedure where the whole colon is removed and the ileum is joined directly to the rectum.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-03-28T17:29:48Z</dce:date>
