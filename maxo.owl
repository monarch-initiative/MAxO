    <!-- http://purl.obolibrary.org/obo/CHEBI_26948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38338"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_63048"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75769"/>
        <obo:IAO_0000115>Any member of the group of 1,3-thiazolium cations that exhibit biological activity against vitamin B1 deficiency in animals. Symptoms of vitamin B1 deficiency include constipation, loss of apetite, fatigue, nausea, delirium, blurry vision and muscle weakness. Severe vitamin B1 deficiency can also lead to a disease known as beriberi. Vitamin B1 consists of the vitamer thiamin and its acid, aldehyde and phosphorylated derivatives (and their corresponding ionized, salt and hydrate forms).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>vitamin B1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>thiamine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thiamines</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thiamins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B1 vitamer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B1 vitamers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamins B1</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vitamin B1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26948"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>vitamin B1</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ChEBI</oboInOwl:hasDbXref>
    </owl:Axiom>
