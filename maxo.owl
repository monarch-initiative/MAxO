        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000887"/>
        <obo:IAO_0000115>An estimated rate of glomerular filtration is calculated from blood creatinine test, age, body size and gender.</obo:IAO_0000115>
