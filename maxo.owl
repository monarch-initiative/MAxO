        <oboInOwl:hasDbXref>MESH:D006615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C64193</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:302543008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000346</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Hip</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Hip</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>hip region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>regio coxae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>coxa</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hip</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001464"/>
