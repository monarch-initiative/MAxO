    <!-- http://purl.obolibrary.org/obo/PATO_0001748 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001857"/>
        <obo:IAO_0000115>A shape quality in which a portion of the outermost boundary of an entity folds in space such that a portion that was originally convex is now concave.</obo:IAO_0000115>
        <rdfs:label>invaginated</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001748"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A shape quality in which a portion of the outermost boundary of an entity folds in space such that a portion that was originally convex is now concave.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


