    <!-- http://purl.obolibrary.org/obo/UBERON_0001897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
