    <!-- http://purl.obolibrary.org/obo/MAXO_0009004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0009004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000533"/>
        <obo:IAO_0000115>A procedure that can determine the DNA sequence for all of the exons (protein coding region) in an individual.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-03-21T18:25:01Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
