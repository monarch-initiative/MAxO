        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048285"/>
        <obo:IAO_0000115>The division of a cell nucleus into two nuclei, with DNA and other nuclear contents distributed between the daughter nuclei.</obo:IAO_0000115>
