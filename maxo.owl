    <!-- http://purl.obolibrary.org/obo/HP_0002664 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An organ or organ-system abnormality that consists of uncontrolled autonomous cell-proliferation which can occur in any part of the body as a benign or malignant neoplasm (tumor).</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Abnormal tissue mass</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>NCIT:C3262</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:108369006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:363346000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0006826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0027651</oboInOwl:hasDbXref>
