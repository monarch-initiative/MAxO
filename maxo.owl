        <oboInOwl:hasDbXref>SCTID:298225002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lamina_propria</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lamina propria mucosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lamina propria mucosae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>tunica propria</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lamina propria</rdfs:label>
    </owl:Class>
