    <!-- http://purl.obolibrary.org/obo/CHEBI_26935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26873"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_parent_hydride"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35193"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any terpenoid derived from a tetraterpene. The term includes compounds in which the C40 skeleton of the parent tetraterpene has been rearranged or modified by the removal of one or more skeletal atoms (generally methyl groups).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>tetraterpenoids</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>C40 isoprenoids</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tetraterpenoides</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tetraterpenoid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26935"/>
