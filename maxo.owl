    <!-- http://purl.obolibrary.org/obo/MAXO_0000443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000015"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000442"/>
        <obo:IAO_0000115>Use of a recombinant therapeutic agent which is chemically identical to or similar to the endogenous glycoprotein erythropoietin (Epo). Epo promotes the differentiation and maturation of hematopoietic progenitors into erythrocytes; is a mitogen and a chemoattractant for endothelial cells; stimulates activated and differentiated B-cells and enhances B-cell immunoglobulin production and proliferation; and is hypoxia-inducible.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-10-08T18:38:34Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
