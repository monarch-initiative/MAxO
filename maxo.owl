        <rdfs:label xml:lang="en">seed or seed product (us cfr)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03400306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03400306">
