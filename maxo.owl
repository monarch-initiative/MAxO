        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001873"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer&apos;s being cylindrical, in which the height is less than the diameter.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>disc-shaped</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>disk-shaped</oboInOwl:hasExactSynonym>
