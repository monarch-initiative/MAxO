    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/MAXO_0000864">
        <obo:IAO_0000115>Uses of chemicals which affect the course of conditions, diseases, syndromes or pathology to benefit the health of an individual.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-24T19:27:35Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
