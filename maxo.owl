        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000601 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000600"/>
        <obo:IAO_0000115>A procedure to remove toxic substances from the blood that is used in patients with end-stage chronic kidney disease or acute kidney failure. This includes hemodialysis and peritoneal dialysis.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-07T19:57:22Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
