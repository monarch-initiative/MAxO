        <oboInOwl:hasDbXref>SCTID:362589007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000385</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000842</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lymphoid_system</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000385</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>lymphatic system</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>lymphatic circulatory system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lymphatic drainage system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>systema lymphoideum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphoid system</rdfs:label>
    </owl:Class>
