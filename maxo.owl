        <oboInOwl:hasExactSynonym>medical oncologist consultation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>medical oncology internist consultation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>medical oncology internist evaluation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>referral to oncologist</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">medical oncologist evaluation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000691"/>
