    <!-- http://purl.obolibrary.org/obo/CHEBI_23044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_23044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26935"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_parent_hydride"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23042"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>One of a class of tetraterpenoids (C40), formally derived from the acyclic parent, psi,psi-carotene by hydrogenation, dehydrogenation, cyclization, oxidation, or combination of these processes. This class includes carotenes, xanthophylls and certain compounds that arise from rearrangement of the skeleton of psi,psi-carotene or by loss of part of this structure. Retinoids are excluded.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>carotenoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>carotenes and carotenoids</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>carotenoids</oboInOwl:hasRelatedSynonym>
        <rdfs:label>carotenoid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23044"/>
