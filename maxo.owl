        <oboInOwl:hasDbXref>NCIT:C12272</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RETIRED_EHDAA2:0002177</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245385001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000256</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pancreatic_duct</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>chief pancreatic duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>duct of Wirsung</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>main pancreatic duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>canal of Wirsung</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ductus pancreatis ventralis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hepaticopancreatic duct</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>EDITOR_NOTE in EHDAA2 this is an epithelium, in FMA the wall consists of epithelium and connective tissue</rdfs:comment>
        <rdfs:label>ventral pancreatic duct</rdfs:label>
    </owl:Class>
