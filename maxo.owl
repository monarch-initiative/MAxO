    <!-- http://purl.obolibrary.org/obo/UBERON_0002471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002529"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002551"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011584"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The middle free limb segment, between the autopod and stylopod segments. Includes as parts the zeugopodial skeleton. Examples: There are two types of zeugopod: forelimb zeugopod (aka forearm), hindlimb zeugopod (aka crus).</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>middle part of limb</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>EFO:0000878</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83016</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002716</oboInOwl:hasDbXref>
