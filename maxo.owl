    <!-- http://purl.obolibrary.org/obo/MAXO_0000572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000572">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MAXO_0000058"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000864"/>
