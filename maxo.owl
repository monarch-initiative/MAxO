        <oboInOwl:hasDbXref>MA:0002754</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:315</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D019579</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PBA:294021746</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Neocortex</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cerebral neocortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>homogenetic cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>homotypical cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isocortex (sensu lato)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neocortex (isocortex)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neopallial cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neopallium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>isocortex</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>iso-cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nonolfactory cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus hypoglossalis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>neocortex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
