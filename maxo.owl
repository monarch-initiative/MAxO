        <oboInOwl:hasExactSynonym>rapid IgM-IgG testing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">rapid IgM-IgG combined antibody testing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000612 -->

