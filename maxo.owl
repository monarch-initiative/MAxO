    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03411223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03411223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002051"/>
