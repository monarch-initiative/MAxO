    <!-- http://purl.obolibrary.org/obo/CL_0000540 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000393"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000404"/>
