    <!-- http://purl.obolibrary.org/obo/MAXO_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000118"/>
        <obo:IAO_0000115>Active immunity refers to the process of exposing the body to an antigen to generate an adaptive immune response: the response takes days/weeks to develop but may be long lasting—even lifelong.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-20T00:31:42Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
