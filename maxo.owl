        <oboInOwl:hasRelatedSynonym>vitamin D vitamer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin D vitamers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin Ds</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamins D</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vitamin D</rdfs:label>
    </owl:Class>
