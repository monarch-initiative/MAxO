    <!-- http://purl.obolibrary.org/obo/UBERON_0015152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002530"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A gland that is typically found in or near the orbital region, in or around either the medial or lateral canthi, and is typically associated with secretions onto the eyeball or associated ducts. Includes the Harderian, nictitans and lacrimal glands.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ocular gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>orbital gland</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gland of ocular region</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015152"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A gland that is typically found in or near the orbital region, in or around either the medial or lateral canthi, and is typically associated with secretions onto the eyeball or associated ducts. Includes the Harderian, nictitans and lacrimal glands.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://github.com/obophenotype/uberon/issues/614</oboInOwl:hasDbXref>
    </owl:Axiom>
    


