    <!-- http://purl.obolibrary.org/obo/CHEBI_16670 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37622"/>
