            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002392"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The upper dilated end of the nasolacrimal duct that is lodged in a deep groove formed by the lacrimal bone and frontal process of the maxilla; it connects the lacrimal canaliculi, which drain tears from the eye&apos;s surface, and the nasolacrimal duct, which conveys this fluid into the nasal cavity; like the nasolacrimal duct, the sac is lined by stratified columnar epithelium with mucus-secreting goblet cells, and is surrounded by connective tissue.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:20289</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001298</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32909</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362534009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lacrimal_sac</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lachrymal sac</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lacrymal sac</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>saccus lacrimalis</oboInOwl:hasExactSynonym>
        <rdfs:label>lacrimal sac</rdfs:label>
    </owl:Class>
