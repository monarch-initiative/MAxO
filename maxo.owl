            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mesoderm that has the potential to develop into a pronephros.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0011090</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0003479</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000067</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001239</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000264</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000067</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>pronephric anlage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric bulge</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric primordium</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>the intermediate mesoderm of the chick embryo acquires its ability to form kidneys through its interactions with the paraxial mesoderm [ISBN:9780878932504 &quot;Developmental Biology&quot;, PMID:10720431 &quot;Signals from trunk paraxial mesoderm induce pronephros formation in chick intermediate mesoderm&quot;]. These interactions induce the expression of TFs including Lim1, Pax2 and Pax6 that cause the intermediate mesoderm to form the kidney</rdfs:comment>
        <rdfs:label>pronephric mesoderm</rdfs:label>
    </owl:Class>
