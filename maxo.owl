                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0009888"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the anatomical structures of a tissue are generated and organized.</obo:IAO_0000115>
        <rdfs:label>tissue morphogenesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048729"/>
