        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000520"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0010203"/>
        <obo:IAO_0000115>Fetal echocardiography is a test that uses sound waves (ultrasound) to evaluate the structure and function of the fetus&apos;s heart.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-03-22T18:19:25Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
