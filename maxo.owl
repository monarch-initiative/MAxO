        <oboInOwl:hasDbXref>NCIT:C159340</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000469">
