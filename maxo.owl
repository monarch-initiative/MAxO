    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000025"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005904"/>
        <rdfs:subClassOf>
