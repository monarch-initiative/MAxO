    <!-- http://purl.obolibrary.org/obo/GO_0007142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007135"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007140"/>
        <obo:IAO_0000115>A cell cycle process comprising the steps by which a cell progresses through male meiosis II, the second meiotic division in the male germline.</obo:IAO_0000115>
