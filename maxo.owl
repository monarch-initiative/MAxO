        <oboInOwl:hasRelatedSynonym>peptido</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>peptidos</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peptide</rdfs:label>
    </owl:Class>
