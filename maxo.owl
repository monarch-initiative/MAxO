        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000026"/>
        <obo:IAO_0000115>A deep heating modality that uses high-frequency acoustic vibrations within body tissues for the treatment of certain medical conditions, such as the alleviation of pain, muscle spasms, and joint contractures.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-03-02T20:08:31Z</dce:date>
