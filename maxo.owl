    <!-- http://purl.obolibrary.org/obo/MAXO_0000610 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000613"/>
        <obo:IAO_0000115>A highly sensitive technique for detecting and measuring antigens or antibodies in a solution; the solution is run over a surface to which immobilized antibodies specific to the substance have been attached, and if the substance is present, it will bind to the antibody layer, and its presence is verified and visualized with an application of antibodies that have been tagged in some way. (BioTech Life Science Dictionary)</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-04-08T14:51:34Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasDbXref>NCIT:C16553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OBI:0000661</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>enzyme linked immunosorbent assay testing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enzyme-linked immunosorbent assay</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">clinical ELISA testing</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000610"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A highly sensitive technique for detecting and measuring antigens or antibodies in a solution; the solution is run over a surface to which immobilized antibodies specific to the substance have been attached, and if the substance is present, it will bind to the antibody layer, and its presence is verified and visualized with an application of antibodies that have been tagged in some way. (BioTech Life Science Dictionary)</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C16553</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000611 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000612"/>
        <obo:IAO_0000115>A type of lateral flow assay that qualitatively detect IgG and IgM antibodies of an infectious disease within human serum, plasma or whole blood in vitro.</obo:IAO_0000115>
