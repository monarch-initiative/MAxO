    <!-- http://purl.obolibrary.org/obo/MAXO_0000682 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000680"/>
        <obo:IAO_0000115>An assessment by an internist who specializes in diseases of the heart and blood vessels and manages complex cardiac conditions, such as heart attacks and life-threatening, abnormal heartbeat rhythms.</obo:IAO_0000115>
