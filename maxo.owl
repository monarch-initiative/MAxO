        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000026"/>
        <obo:IAO_0000115>A therapy using microwaves to focus on and heat up tissue with high water content, such as muscle.</obo:IAO_0000115>
