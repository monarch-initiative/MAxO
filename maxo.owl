    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000896">
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001194"/>
        <rdfs:label>obsolete ureteroscopy</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000890"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001194"/>
        <obo:IAO_0000115>A ureteroscope is inserted into the ureter and a wire basket inserted through the tube to remove the stone(s). In addition, a laser or other mechanical device can be used to break up the stone(s).</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T18:26:36Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <rdfs:label xml:lang="en">ureteroscopic stone removal</rdfs:label>
    </owl:Class>
    


