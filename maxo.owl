    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115>A protein that has a core domain structure of signal sequence, propeptide, five Cadherin domains (Pfam:PF00028), a transmembrane region, and a Cadherin cytoplasmic region (Pfam:PF01049). Cadherins function as adhesion molecules that mediate Ca2+-dependent cell-cell adhesion in solid tissues.</obo:IAO_0000115>
