    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000447"/>
        <obo:IAO_0000115>Taking or cutting out solid matter from a body part. The solid matter contained in the definition may be an abnormal byproduct of a biological function or a foreign body. It may be embedded in a body part, or in the lumen of a tubular body part. The solid matter may or may not have been previously broken into pieces.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-02T19:00:34Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>extirpation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">surgical extirpation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Taking or cutting out solid matter from a body part. The solid matter contained in the definition may be an abnormal byproduct of a biological function or a foreign body. It may be embedded in a body part, or in the lumen of a tubular body part. The solid matter may or may not have been previously broken into pieces.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ICD-10-PCS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


