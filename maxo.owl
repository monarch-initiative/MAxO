        <oboInOwl:hasExactSynonym xml:lang="en">mytilidae</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">A mussel which is dead or alive and has a relatively intact body.</rdfs:comment>
        <rdfs:label xml:lang="en">mussel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_03411226 -->

