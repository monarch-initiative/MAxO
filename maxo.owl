    <!-- http://purl.obolibrary.org/obo/GO_0048518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050789"/>
        <rdfs:subClassOf>
