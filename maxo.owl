        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000723"/>
        <obo:IAO_0000115>An assessment by a physician who diagnoses and treats patients experiencing problems with acute or chronic pain, or pain related to cancer, in both hospital and outpatient settings and coordinates care needs with other specialists.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-01T19:56:48Z</dce:date>
