                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SO_0001062"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The signal_peptide is a short region of the peptide located at the N-terminus that directs the protein to be secreted or part of membrane components.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Signal_peptide</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>INSDC_feature:sig_peptide</oboInOwl:hasExactSynonym>
