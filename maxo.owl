    <!-- http://purl.obolibrary.org/obo/MAXO_0000887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000886"/>
        <obo:IAO_0000115>A measurement of the volume of fluid filtered from the renal glomerular capillaries into the Bowman&apos;s capsule per unit time.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-09T13:28:29Z</dce:date>
