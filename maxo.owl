        <oboInOwl:hasExactSynonym>fetal scalp electrode monitoring</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">internal fetal heart rate monitoring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
