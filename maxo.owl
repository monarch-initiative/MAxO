                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008281"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A circumscribed mass of ectodermal cells which bud off from the dental lamina; it becomes cup-shaped and develops on its internal face the ameloblast layer of cells that produces the enamel cap of a developing tooth.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001722</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0271</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:32888</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:312389</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004658</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362863002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005138</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Enamel_organ</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005138</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dental organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enamel organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>odontogenic organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>organum enameleum</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>. Alternate definition: A cellular aggregation seen in histologic sections of a developing tooth. It lies above a condensation of ectomesenchymal cells called the odontogenic papilla.</rdfs:comment>
        <rdfs:label>tooth enamel organ</rdfs:label>
    </owl:Class>
