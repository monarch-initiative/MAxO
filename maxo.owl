        <oboInOwl:hasRelatedSynonym>maintenance of genome integrity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nuclear genome maintenance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chromosome organization</rdfs:label>
