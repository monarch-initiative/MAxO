                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A prenatal test in which a sample of chorionic villi is removed from the placenta for testing. The sample can be taken through the cervix (transcervical) or the abdominal wall (transabdominal). Mayo Clinic</obo:IAO_0000115>
        <obo:dcterms_creator>http://orcid.org/0000-0001-7941-2961</obo:dcterms_creator>
        <dce:date>2022-06-23T20:39:14Z</dce:date>
