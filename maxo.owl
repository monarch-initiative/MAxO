        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000526"/>
        <obo:IAO_0000115>A systemic evaluation of the body and its functions using visual inspection, palpation, percussion and auscultation. The purpose is to determine the presence or absence of physical signs of disease or abnormality for an individual&apos;s health assessment.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-04T17:45:04Z</dce:date>
