    <!-- http://purl.obolibrary.org/obo/FOODON_00001260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001102"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002420"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_27292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
