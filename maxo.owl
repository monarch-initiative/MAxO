                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0006412"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The successive addition of amino acid residues to a nascent polypeptide chain during protein biosynthesis.</obo:IAO_0000115>
