    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0001561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001560"/>
        <obo:IAO_0000115>A type of minimally invasive glaucoma surgery that increases trabecular outflow.</obo:IAO_0000115>
