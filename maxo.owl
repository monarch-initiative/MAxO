    <!-- http://purl.obolibrary.org/obo/CHEBI_176843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_176843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75769"/>
        <obo:IAO_0000115>Any member of a group of cobalamin vitamers that exhibit biological activity against vitamin B12 deficiency. Vitamin B12 deficiency is associated with low red blood cell count and anemia. The vitamers are found in foods such as cereals, meat, fish, and poultry. The vitamers include adenosylcobalamin, hydroxocobalamin, cyanocobalamin, aquacobalamin, nitritocobalamin and methylcobabalamin (also includes their ionized, salt and phosphate derivatives).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>vitamin B12</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B-12</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B12 vitamer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B12 vitamers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamins B12</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vitamin B12</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_176843"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>vitamin B12</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ChEBI</oboInOwl:hasDbXref>
