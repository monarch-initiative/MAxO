    <!-- http://purl.obolibrary.org/obo/CL_0000815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002419"/>
