        <oboInOwl:hasRelatedSynonym>adrenergic uptake inhibitors</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>norepinephrine reuptake inhibitor</oboInOwl:hasRelatedSynonym>
