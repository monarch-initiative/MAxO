                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0008007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A muscle tissue that is associated with soft internal organs (viscera).</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-02-16T10:17:46Z</dcterms:date>
        <oboInOwl:hasExactSynonym>visceral muscle</oboInOwl:hasExactSynonym>
        <rdfs:comment>It is quite common to refer to visceral muscles as smooth muscles, by analogy with vertebrates; however, most visceral muscles in arthropods are actually striated.</rdfs:comment>
        <rdfs:label>visceral muscle tissue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_8600004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A muscle tissue that is associated with soft internal organs (viscera).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BTO:0002780</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CLAO:0001295</oboInOwl:hasDbXref>
