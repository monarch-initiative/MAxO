        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001444"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0001467"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
