    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000132"/>
        <obo:IAO_0000115>A low-cost, high-resolution imaging tool consisting of a 1-mm diameter fiber-optic bundle that produces subcellular imaging at 1,000x magnification and 4 micrometer resolution, allowing for minimally invasive bioimaging.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-01-20T19:03:17Z</dce:date>
        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
