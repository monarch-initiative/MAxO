    <!-- http://purl.obolibrary.org/obo/GO_0010646 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0010646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050794"/>
        <rdfs:subClassOf>
            <owl:Restriction>
