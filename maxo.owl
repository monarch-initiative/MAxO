        <dcterms:creator rdf:resource="http://orcid.org/0000-0001-7941-2961"/>
        <oboInOwl:hasExactSynonym>MHT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>menopausal hormone replacement therapy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>postmenopausal hormone therapy</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">menopausal hormone therapy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Treatment with estrogens or estrogen/progesterone after menopause or ovariectomy to prevent pathological effects of decreased estrogen production.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NCIT:C15599</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000745 -->

