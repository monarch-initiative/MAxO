        </rdfs:subClassOf>
        <obo:IAO_0000115>A oligopotent progenitor cell committed to the lymphoid lineage.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>common lymphocyte precursor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>common lymphocyte progenitor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>common lymphoid precursor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>CLP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ELP</oboInOwl:hasRelatedSynonym>
