    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MAXO_0000506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000503"/>
        <obo:IAO_0000115>Techniques for administering artificial respiration without the need for intratracheal intubation.</obo:IAO_0000115>
        <dce:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-01-23T17:52:50Z</dce:date>
