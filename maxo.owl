        <oboInOwl:hasDbXref>PMID:16987572</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17204662</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17479180</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20414831</oboInOwl:hasDbXref>
