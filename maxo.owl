        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A physical quality inhering in an entity exhibiting the physical characteristics of an amorphous (non-crystalline) form of matter between a gas and a solid that has a definite volume, but no definite shape.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.chemistry-dictionary.com/definition/liquid.php</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
