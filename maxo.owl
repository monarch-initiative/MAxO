        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000680"/>
        <obo:IAO_0000115>An assessment by a specialist who specializes in intricate technical procedures to evaluate heart rhythms and determine appropriate treatment.</obo:IAO_0000115>
