    <!-- http://purl.obolibrary.org/obo/GO_0042092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0042092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006955"/>
        <obo:IAO_0000115>An immune response which is associated with resistance to extracellular organisms such as helminths and pathological conditions such as allergy, which is orchestrated by the production of particular cytokines, most notably IL-4, IL-5, IL-10, and IL-13, by any of a variety of cell types including T-helper 2 cells, eosinophils, basophils, mast cells, and nuocytes, resulting in enhanced production of certain antibody isotypes and other effects.</obo:IAO_0000115>
