    <!-- http://purl.obolibrary.org/obo/GO_0008217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0065008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that modulates the force with which blood travels through the circulatory system. The process is controlled by a balance of processes that increase pressure and decrease pressure.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Blood_pressure#Regulation</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>blood pressure regulation</oboInOwl:hasExactSynonym>
