        <oboInOwl:hasDbXref>Wikipedia:Urogenital_folds</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>urethral fold</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>urogenital fold</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>urogenital ridge</oboInOwl:hasRelatedSynonym>
        <rdfs:label>urogenital fold</rdfs:label>
    </owl:Class>
