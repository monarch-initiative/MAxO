    <!-- http://purl.obolibrary.org/obo/GO_0045580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0045619"/>
